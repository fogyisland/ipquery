node_modules/
# Root build output only. up/dist/ is the deployable copy of this and
# IS committed — anchoring the rule with a leading slash keeps git from
# matching up/dist/ as well.
/dist/
coverage/
data/
*.mmdb
*.xdb
*.csv.gz
*.csv
# ...except the test fixtures. The rules above exist to keep multi-megabyte
# library downloads out of git; the fixtures are a few hundred bytes each
# and the tests that read them fail outright without them. Without this
# exemption a fresh clone and every new worktree start with a red suite.
!fixtures/*.csv
!fixtures/*.csv.gz
.env
.env.local
*.log

# Dev-only helpers under scripts/dev/ — keep the .ts files (committed), ignore
# their runtime artifacts (screenshots, traces, etc.).
scripts/dev/*.png
scripts/dev/*.trace.zip
scripts/dev/*.zip
# Scratch files — local commit-message drafts, never committed
.superpowers/scratch/

# Vitest JSON reports — written by `--outputFile=…` runs, never committed
*-result.json
integration-result.json

# The E2E ETL pipeline writes its downloaded library data here. The
# `*.csv` rules above cover the finished files, but the directory and the
# `.part-` files a download-in-progress leaves behind are not matched by
# any of them — and an interrupted download is the normal case on a slow
# link.
test/tmp-data-e2e/

# Local verification scratch installs — an isolated copy of the build with
# its own .env (which holds generated secrets). Never committed.
verify-tmp/
