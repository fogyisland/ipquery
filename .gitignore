node_modules/
# Root build output only. up/dist/ is the deployable copy of this and
# IS committed — anchoring the rule with a leading slash keeps git from
# matching up/dist/ as well.
/dist/
coverage/
data/
*.mmdb
*.xdb
*.csv.gz
*.csv
.env
.env.local
*.log

# Dev-only helpers under scripts/dev/ — keep the .ts files (committed), ignore
# their runtime artifacts (screenshots, traces, etc.).
scripts/dev/*.png
scripts/dev/*.trace.zip
scripts/dev/*.zip
# Scratch files — local commit-message drafts, never committed
.superpowers/scratch/

# Vitest JSON reports — written by `--outputFile=…` runs, never committed
*-result.json
integration-result.json

# Local verification scratch installs — an isolated copy of the build with
# its own .env (which holds generated secrets). Never committed.
verify-tmp/
