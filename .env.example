# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=rootpass
DB_NAME=ipquery
DB_POOL_SIZE=10

# Data sources
MAXMIND_LICENSE_KEY=
MAXMIND_EDITIONS=GeoLite2-City,GeoLite2-ASN

# API
PORT=3000
RATE_LIMIT=60

# ETL schedule (cron)
ETL_SCHEDULE=0 2 * * *
ETL_TIMEZONE=UTC

# Raw data directory
DATA_DIR=./data