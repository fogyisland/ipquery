{{> auth-head}}
<div class="auth-form">
  <form method="POST" action="/login">
    <input type="hidden" name="csrf" value="{{req.csrfToken}}">
    {{> form-field name="email" type="email" label=(req.t 'auth.email') required=true autocomplete="email" value=email }}
    <div class="form-field">
      <label for="password">
        <span>{{req.t 'auth.password.label'}}</span>
        <a class="auth-label-link" href="/forgot">{{req.t 'auth.forgot.title'}}</a>
      </label>
      <input type="password" name="password" id="password" required autocomplete="current-password">
    </div>
    <button type="submit" class="btn-primary">{{req.t 'auth.login.submit'}}</button>
  </form>
</div>
<p class="auth-switch">
  <span class="auth-switch-line">
    <span>{{req.t 'auth.login.noAccount'}}</span>
    <a href="/signup">{{req.t 'auth.shell.createAccount'}}</a>
  </span>
</p>
{{#if verifyRequired}}
<div class="auth-secondary-action">
  <form method="POST" action="/verify/resend/{{verifyUserId}}">
    <input type="hidden" name="csrf" value="{{req.csrfToken}}">
    <button type="submit">{{req.t 'auth.verify.resend'}}</button>
  </form>
</div>
{{/if}}
