{{!-- Same vocabulary as errors/csrf.hbs (.boot-step-head / .boot-lede /
     .boot-actions) so the two error pages read as one family. A bare <h1>
     inherits whatever the shell provides, which is why this page looked
     unstyled next to the CSRF page. --}}
<header class="boot-step-head">
  <h1>{{req.t "error.404.title"}}</h1>
  <p class="boot-lede">{{req.t "error.404.body"}}</p>
</header>
<div class="boot-actions">
  <a href="/" class="btn-primary">{{req.t "error.404.home"}}</a>
</div>
