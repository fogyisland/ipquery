{{!--
  Profile details: the nickname and the email address.

  Two separate forms, because they are two separate operations. The
  nickname is a display string the user picks; the email address is the
  account's identity and the address every notification goes to. Saving
  one must not silently save the other — the form that was filled in is
  the only one that acts, and the `action` field says which.
--}}
<h1>{{req.t 'dashboard.profile.details.title'}}</h1>
{{#if flash.success}}<div class="flash flash-success">{{flash.success}}</div>{{/if}}
{{#if flash.error}}<div class="flash flash-error">{{flash.error}}</div>{{/if}}

<section class="card">
  <h2 class="card-title">{{req.t 'dashboard.profile.displayName'}}</h2>
  <form method="POST" action="/dashboard/profile">
    <input type="hidden" name="csrf" value="{{req.csrfToken}}">
    <input type="hidden" name="action" value="displayName">
    {{> form-field name="displayName" label=(req.t 'dashboard.profile.displayName') value=req.user.displayName required=true }}
    <button type="submit" class="btn-primary">{{req.t 'dashboard.profile.save'}}</button>
  </form>
</section>

<section class="card">
  <h2 class="card-title">{{req.t 'dashboard.profile.email'}}</h2>
  <form method="POST" action="/dashboard/profile">
    <input type="hidden" name="csrf" value="{{req.csrfToken}}">
    <input type="hidden" name="action" value="email">
    {{> form-field name="email" type="email" label=(req.t 'dashboard.profile.email') value=req.user.email required=true help=(req.t 'dashboard.profile.emailHint') }}
    <button type="submit" class="btn-primary">{{req.t 'dashboard.profile.save'}}</button>
  </form>
</section>

<p class="profile-back"><a href="/dashboard/profile">{{req.t 'dashboard.profile.backToOverview'}}</a></p>
