# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=rootpass
DB_NAME=ipquery
DB_POOL_SIZE=10

# Data sources
MAXMIND_LICENSE_KEY=
MAXMIND_EDITIONS=GeoLite2-City,GeoLite2-ASN

# API
PORT=5001
RATE_LIMIT=60

# ETL schedule (cron)
ETL_SCHEDULE=0 2 * * *
ETL_TIMEZONE=UTC

# Raw data directory
DATA_DIR=./data

# Web
WEB_BASE_URL=http://localhost:5001
COOKIE_DOMAIN=
COOKIE_SECURE=false
SESSION_TTL_HOURS=168
SESSION_SECRET=
CSRF_SECRET=

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="IPQuery <noreply@example.com>"

# Security
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
SIGNUP_RATE_PER_IP_PER_HOUR=5
VERIFY_RESEND_COOLDOWN_SECONDS=60

# Admin bootstrap (only used if users table is empty)
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Admin creation (consumed by `make create-admin`)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

