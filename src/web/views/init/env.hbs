<header class="boot-step-head">
  <h1>{{req.t "setup.env.title"}}</h1>
  <p class="boot-lede">{{req.t "setup.env.intro"}}</p>
</header>

{{#if error}}<div class="boot-alert"><p class="form-error">{{error}}</p></div>{{/if}}

{{#if envCreated}}
<div class="boot-alert">
  <p class="form-help">{{req.t "setup.env.created"}}</p>
</div>
{{/if}}

<form method="POST" action="/init/env" class="boot-form">
  <input type="hidden" name="csrf" value="{{csrfToken}}">

  {{!-- No port field. The port the Node process listens on is an
       internal detail when a reverse proxy is in front — the operator
       never types it, and the value in .env is generated. Exposing it
       as a form field only invited the mistake of putting the PUBLIC
       port (443) here, which is the proxy's port, not Node's. --}}
  {{> form-field name="baseUrl" label=(req.t "setup.env.baseUrlLabel") required=true value=env.baseUrl help=(req.t "setup.env.baseUrlHelp") }}
  {{#if env.baseUrlSuggested}}
  <p class="boot-note">{{req.t "setup.env.baseUrlSchemeHint"}}</p>
  {{/if}}

  {{#if env.hasSecrets}}
  {{> form-field name="sessionSecret" type="password" label=(req.t "setup.env.sessionSecretLabel") placeholder=(req.t "setup.env.secretKeptPlaceholder") autocomplete="new-password" help=(req.t "setup.env.secretKeepHelp") }}
  {{> form-field name="csrfSecret" type="password" label=(req.t "setup.env.csrfSecretLabel") placeholder=(req.t "setup.env.secretKeptPlaceholder") autocomplete="new-password" help=(req.t "setup.env.secretKeepHelp") }}
  {{else}}
  <p class="boot-note">{{req.t "setup.env.secretAutoHelp"}}</p>
  {{/if}}

  <p class="boot-note">{{req.t "setup.env.envHint"}}</p>

  <div class="boot-actions">
    <button type="submit" class="btn-primary">{{req.t "setup.env.submit"}}</button>
    <a href="/init/database" class="boot-back">{{req.t "setup.boot.backToStart"}}</a>
  </div>
</form>
