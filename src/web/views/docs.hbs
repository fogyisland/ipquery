{{!-- Task 14: tool-style API reference. Renders inside layouts/app.
     Lists 4 public endpoints (lookup, lookup/:ip, stats, healthz) with
     curl/fetch/Python/Node examples. Base URL is left as a placeholder so
     the user can copy and substitute; documented in the table below. --}}
<p class="home-subtitle">{{req.t 'docs.subtitle'}}</p>

<div class="card">
  <h3 class="card-title">{{req.t 'docs.endpointsTitle'}}</h3>
  <table class="table">
    <thead>
      <tr>
        <th>{{req.t 'docs.colMethod'}}</th>
        <th>{{req.t 'docs.colPath'}}</th>
        <th>{{req.t 'docs.colDescription'}}</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><code>GET</code></td>
        <td><code>/lookup?ip=8.8.8.8</code></td>
        <td>{{req.t 'docs.endpoints.lookup'}}</td>
      </tr>
      <tr>
        <td><code>GET</code></td>
        <td><code>/lookup/8.8.8.8</code></td>
        <td>{{req.t 'docs.endpoints.lookupPath'}}</td>
      </tr>
      <tr>
        <td><code>GET</code></td>
        <td><code>/stats</code></td>
        <td>{{req.t 'docs.endpoints.stats'}}</td>
      </tr>
      <tr>
        <td><code>GET</code></td>
        <td><code>/healthz</code></td>
        <td>{{req.t 'docs.endpoints.healthz'}}</td>
      </tr>
    </tbody>
  </table>
</div>

<div class="card">
  <h3 class="card-title">{{req.t 'docs.examplesTitle'}}</h3>

  <p><strong>cURL</strong></p>
  <pre><code>curl "https://api.example.com/lookup?ip=8.8.8.8"</code></pre>

  <p><strong>fetch (Browser / Node 18+)</strong></p>
  <pre><code>fetch('https://api.example.com/lookup?ip=8.8.8.8')
  .then(r =&gt; r.json())
  .then(console.log);</code></pre>

  <p><strong>Python</strong></p>
  <pre><code>import urllib.request, json
with urllib.request.urlopen('https://api.example.com/lookup?ip=8.8.8.8') as r:
    print(json.loads(r.read()))</code></pre>

  <p><strong>Node.js</strong></p>
  <pre><code>const res = await fetch('https://api.example.com/lookup?ip=8.8.8.8');
console.log(await res.json());</code></pre>
</div>

<div class="card">
  <h3 class="card-title">{{req.t 'docs.authTitle'}}</h3>
  <p>{{req.t 'docs.authBody'}}</p>
  <pre><code>curl "https://api.example.com/lookup?ip=8.8.8.8&amp;key=ipq_xxxxxxxxxxxx"</code></pre>
</div>
