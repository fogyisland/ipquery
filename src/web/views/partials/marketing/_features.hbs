<section class="m-section m-section--alt">
  <div class="m-section-inner">
    <div class="m-section-head">
      <span class="m-eyebrow">{{req.t 'home.features.eyebrow'}}</span>
      <h2 class="m-section-title">{{req.t 'home.features.title'}}</h2>
      <p class="m-section-sub">{{req.t 'home.features.sub'}}</p>
    </div>

    <div class="m-features">
      <article class="m-feature">
        <div class="m-feature-mark">{{req.t 'home.features.sources.mark'}}</div>
        <h3 class="m-feature-title">{{req.t 'home.features.sources.title'}}</h3>
        <p class="m-feature-sub">{{req.t 'home.features.sources.sub'}}</p>
        <div class="m-feature-stat"><span>3</span><small>{{req.t 'home.features.sources.stat'}}</small></div>
      </article>

      <article class="m-feature">
        <div class="m-feature-mark">{{req.t 'home.features.coverage.mark'}}</div>
        <h3 class="m-feature-title">{{req.t 'home.features.coverage.title'}}</h3>
        <p class="m-feature-sub">{{req.t 'home.features.coverage.sub'}}</p>
        <div class="m-feature-stat"><span>{{ipCount}}</span><small>{{req.t 'home.features.coverage.stat'}}</small></div>
      </article>

      <article class="m-feature">
        <div class="m-feature-mark">{{req.t 'home.features.speed.mark'}}</div>
        <h3 class="m-feature-title">{{req.t 'home.features.speed.title'}}</h3>
        <p class="m-feature-sub">{{req.t 'home.features.speed.sub'}}</p>
        <div class="m-feature-stat"><span>&lt;100<small>ms</small></span><small>{{req.t 'home.features.speed.stat'}}</small></div>
      </article>
    </div>
  </div>
</section>
