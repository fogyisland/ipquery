{{!-- Hero: thesis + IP query + live byte-grid signature.
     Right column is a static demo (8.8.8.8 hits US/Mountain View) so the
     page renders meaningfully without JS; the form below the thesis is
     what the visitor actually submits to /try. --}}
<section class="m-hero">
  <div class="m-hero-inner">
    <div class="m-hero-content">
      <span class="m-eyebrow">{{req.t 'home.heroEyebrow'}}</span>
      <h1 class="m-hero-title">{{{req.t 'home.heroTitleAccent'}}}</h1>
      <p class="m-hero-sub">{{req.t 'home.heroSubLong'}}</p>

      <form class="m-hero-query" method="POST" action="/try">
        <input type="hidden" name="csrf" value="{{req.csrfToken}}">
        <input type="text" name="ip" placeholder="{{req.t 'lookup.input.placeholder'}}" required autocomplete="off" autofocus>
        <button type="submit">{{req.t 'lookup.submit'}}</button>
      </form>

      <div class="m-hero-query-meta">
        <span><b>{{ipCount}}</b> {{req.t 'home.ipRanges'}}</span>
        <span><b>3</b> {{req.t 'home.metaSources'}}</span>
        <span><b>&lt;100ms</b> {{req.t 'home.metaLatency'}}</span>
      </div>
    </div>

    <div class="m-ipgrid" aria-hidden="true">
      <div class="m-ipgrid-head">
        <span class="m-ipgrid-label">{{req.t 'home.ipgrid.demoLabel'}}</span>
        <span class="m-ipgrid-target">8.8.8.8</span>
      </div>
      <div class="m-ipgrid-bytes">
        {{#each (range 0 256)}}
          <div class="m-ipgrid-byte {{#if (or (eq this 8) (eq this 9))}}m-ipgrid-byte--match{{/if}}">{{this}}</div>
        {{/each}}
      </div>
      <dl class="m-ipgrid-result">
        <dt>{{req.t 'home.ipgrid.country'}}</dt><dd><code>US</code> United States</dd>
        <dt>{{req.t 'home.ipgrid.region'}}</dt><dd>California</dd>
        <dt>{{req.t 'home.ipgrid.city'}}</dt><dd>Mountain View</dd>
        <dt>{{req.t 'home.ipgrid.asn'}}</dt><dd><code>AS15169</code> Google LLC</dd>
      </dl>
    </div>
  </div>
</section>
