<div class="m-card m-card--result">
  <h3 class="m-card-title">{{req.t 'lookup.found' ip=result.ip country=result.country.name}}</h3>
  <dl class="m-result-grid">
    <dt>{{req.t 'try.country'}}</dt>
    <dd>{{result.country.name}} (<code>{{result.country.code}}</code>) <span class="m-source">{{result.country.source}}</span></dd>
    {{#if result.region}}<dt>{{req.t 'try.region'}}</dt><dd>{{result.region}}</dd>{{/if}}
    {{#if result.city}}<dt>{{req.t 'try.city'}}</dt><dd>{{result.city.name}} <span class="m-source">{{result.city.source}}</span></dd>{{/if}}
    {{#if result.isp}}<dt>{{req.t 'try.isp'}}</dt><dd>{{result.isp.name}} <span class="m-source">{{result.isp.source}}</span></dd>{{/if}}
    {{#if result.asn}}<dt>{{req.t 'try.asn'}}</dt><dd>{{result.asn.number}} {{result.asn.org}} <span class="m-source">{{result.asn.source}}</span></dd>{{/if}}
  </dl>
</div>