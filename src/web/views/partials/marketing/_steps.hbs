<section class="m-section">
  <div class="m-section-inner">
    <div class="m-section-head">
      <span class="m-eyebrow">{{req.t 'home.steps.eyebrow'}}</span>
      <h2 class="m-section-title">{{req.t 'home.steps.title'}}</h2>
      <p class="m-section-sub">{{req.t 'home.steps.sub'}}</p>
    </div>

    <div class="m-steps">
      <article class="m-step">
        <div class="m-step-num">01</div>
        <h3 class="m-step-title">{{req.t 'home.steps.s1.title'}}</h3>
        <p class="m-step-sub">{{req.t 'home.steps.s1.sub'}}</p>
      </article>

      <article class="m-step">
        <div class="m-step-num">02</div>
        <h3 class="m-step-title">{{req.t 'home.steps.s2.title'}}</h3>
        <p class="m-step-sub">{{req.t 'home.steps.s2.sub'}}</p>
      </article>

      <article class="m-step">
        <div class="m-step-num">03</div>
        <h3 class="m-step-title">{{req.t 'home.steps.s3.title'}}</h3>
        <p class="m-step-sub">{{req.t 'home.steps.s3.sub'}}</p>
      </article>
    </div>
  </div>
</section>
