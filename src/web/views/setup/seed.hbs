<section class="setup-step">
  <h1>Seed IP ranges</h1>
  <form method="POST" action="/setup/seed">
    <input type="hidden" name="csrf" value="{{csrfToken}}">
    <div class="form-field">
      <label><input type="radio" name="load" value="true" checked> Load 50 seed IPs</label>
    </div>
    <div class="form-field">
      <label><input type="radio" name="load" value="false"> Skip seed</label>
    </div>
    <button type="submit" class="btn-primary">Next</button>
  </form>
</section>
