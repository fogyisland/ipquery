{{!--
  Seed step. Two visual modes selected by which block the GET handler
  populated: a progress panel while a background ETL is running, or the
  three-option choice form. The setup-progress-status--* class is kept
  verbatim because the integration suite asserts on it.
--}}

{{#if progress}}
  <header class="boot-step-head">
    <h1>{{req.t "setup.seed.progress.title"}}</h1>
    <p class="boot-lede">{{req.t "setup.boot.seedProgressLede"}}</p>
  </header>

  {{#if progress.run}}
    <p class="setup-progress-status setup-progress-status--{{progress.run.status}}">
      {{#if (eq progress.run.status "success")}}
        {{req.t "setup.seed.progress.success" rows=progress.run.mergedRecords}}
      {{else if (eq progress.run.status "failed")}}
        {{req.t "setup.seed.progress.failed"}}
      {{else}}
        {{req.t "setup.seed.progress.running"}}
      {{/if}}
    </p>

    {{#if (eq progress.run.status "running")}}
      <div class="setup-progress-spinner" aria-hidden="true"></div>
    {{/if}}

    <dl class="boot-kv">
      <div><dt>{{req.t "setup.seed.progress.runId"}}</dt><dd>#{{progress.run.id}}</dd></div>
      <div><dt>{{req.t "setup.seed.progress.started"}}</dt><dd>{{formatDate progress.run.startedAt}}</dd></div>
      {{#if progress.run.finishedAt}}
        <div><dt>{{req.t "setup.seed.progress.finished"}}</dt><dd>{{formatDate progress.run.finishedAt}}</dd></div>
      {{/if}}
      {{#if progress.run.mergedRecords}}
        <div><dt>{{req.t "setup.seed.progress.merged"}}</dt><dd>{{progress.run.mergedRecords}}</dd></div>
      {{/if}}
      {{#if progress.run.errorMessage}}
        <div><dt>{{req.t "setup.seed.progress.error"}}</dt><dd><code>{{progress.run.errorMessage}}</code></dd></div>
      {{/if}}
    </dl>

    {{#if (eq progress.run.status "success")}}
      <p class="boot-status-note">{{req.t "setup.seed.progress.successHint"}}</p>
      <form method="POST" action="/setup/seed" class="boot-form">
        <input type="hidden" name="csrf" value="{{csrfToken}}">
        <input type="hidden" name="mode" value="etl-done">
        <div class="boot-actions">
          <button type="submit" class="btn-primary">{{req.t "setup.seed.progress.continue"}}</button>
        </div>
      </form>
    {{else if (eq progress.run.status "failed")}}
      <p class="boot-status-note">{{req.t "setup.seed.etl.retryHint"}}</p>
      <form method="POST" action="/setup/seed" class="boot-form">
        <input type="hidden" name="csrf" value="{{csrfToken}}">
        <div class="boot-options" role="radiogroup" aria-label="{{req.t 'setup.seed.retry'}}">
          <div class="boot-option">
            <input type="radio" id="seed-retry-demo" name="mode" value="demo" checked>
            <label class="boot-option-label" for="seed-retry-demo">
              <span class="boot-option-title">{{req.t "setup.seed.demo.label"}}</span>
              <span class="boot-option-hint">{{req.t "setup.seed.demo.hint"}}</span>
            </label>
          </div>
          <div class="boot-option">
            <input type="radio" id="seed-retry-etl" name="mode" value="etl">
            <label class="boot-option-label" for="seed-retry-etl">
              <span class="boot-option-title">{{req.t "setup.seed.etl.label"}}</span>
              <span class="boot-option-hint">{{req.t "setup.seed.etl.retryHint"}}</span>
            </label>
          </div>
        </div>
        <div class="boot-actions">
          <button type="submit" class="btn-primary">{{req.t "setup.seed.retry"}}</button>
        </div>
      </form>
    {{else}}
      <meta http-equiv="refresh" content="3">
      <p class="boot-status-note">{{req.t "setup.seed.progress.autoRefresh"}}</p>
    {{/if}}
  {{else}}
    <p class="setup-progress-status setup-progress-status--running">{{req.t "setup.seed.progress.starting"}}</p>
    <div class="setup-progress-spinner" aria-hidden="true"></div>
    <meta http-equiv="refresh" content="2">
  {{/if}}
{{else}}
  <header class="boot-step-head">
    <h1>{{req.t "setup.seed.title"}}</h1>
    <p class="boot-lede">{{req.t "setup.seed.intro"}}</p>
  </header>

  {{#if error}}<div class="boot-alert"><p class="form-error">{{error}}</p></div>{{/if}}

  <form method="POST" action="/setup/seed" class="boot-form">
    <input type="hidden" name="csrf" value="{{csrfToken}}">
    <div class="boot-options" role="radiogroup" aria-label="{{req.t 'setup.seed.title'}}">
      <div class="boot-option">
        <input type="radio" id="seed-mode-etl" name="mode" value="etl" checked>
        <label class="boot-option-label" for="seed-mode-etl">
          <span class="boot-option-title">{{req.t "setup.seed.etl.label"}}</span>
          <span class="boot-option-hint">{{req.t "setup.seed.etl.hint"}}</span>
        </label>
      </div>
      <div class="boot-option">
        <input type="radio" id="seed-mode-demo" name="mode" value="demo">
        <label class="boot-option-label" for="seed-mode-demo">
          <span class="boot-option-title">{{req.t "setup.seed.demo.label"}}</span>
          <span class="boot-option-hint">{{req.t "setup.seed.demo.hint"}}</span>
        </label>
      </div>
      <div class="boot-option">
        <input type="radio" id="seed-mode-skip" name="mode" value="skip">
        <label class="boot-option-label" for="seed-mode-skip">
          <span class="boot-option-title">{{req.t "setup.seed.skip.label"}}</span>
          <span class="boot-option-hint">{{req.t "setup.seed.skip.hint"}}</span>
        </label>
      </div>
    </div>
    <div class="boot-actions">
      <button type="submit" class="btn-primary">{{req.t "setup.seed.submit"}}</button>
      <a href="/setup/admin" class="boot-back">{{req.t "common.back"}}</a>
    </div>
  </form>
{{/if}}
