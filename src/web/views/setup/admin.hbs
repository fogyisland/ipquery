<section class="setup-step">
  <h1>{{req.t 'setup.admin.title'}}</h1>
  {{#if error}}<p class="form-error">{{error}}</p>{{/if}}
  <form method="POST" action="/setup/admin">
    <input type="hidden" name="csrf" value="{{csrfToken}}">
    {{> form-field name="email" type="email" label=(req.t 'setup.admin.emailLabel') required=true autocomplete="email" }}
    {{> form-field name="password" type="password" label=(req.t 'setup.admin.passwordLabel') required=true autocomplete="new-password" help=(req.t 'setup.admin.passwordHint') }}
    {{> form-field name="displayName" label=(req.t 'setup.admin.nameLabel') required=true autocomplete="nickname" }}
    <button type="submit" class="btn-primary">{{req.t 'setup.admin.submit'}}</button>
  </form>
</section>
