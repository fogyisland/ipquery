{{! SPDX-License-Identifier: MIT }}
<section class="setup-step">
  <h1>{{req.t "setup.complete.title"}}</h1>
  <p>{{req.t "setup.complete.body"}}</p>
  {{#if error}}<p class="form-error">{{error}}</p>{{/if}}
  <ul class="setup-summary">
    <li><strong>{{req.t "setup.complete.siteName"}}:</strong> {{summary.siteName}}</li>
    <li><strong>{{req.t "setup.complete.adminEmail"}}:</strong> {{summary.adminEmail}}</li>
    <li><strong>{{req.t "setup.complete.seedLoaded"}}:</strong> {{#if summary.seedLoaded}}{{req.t "setup.complete.yes"}}{{else}}{{req.t "setup.complete.no"}}{{/if}}</li>
  </ul>
  <form method="POST" action="/setup/complete">
    <input type="hidden" name="csrf" value="{{csrfToken}}" />
    <button type="submit" class="btn-primary">{{req.t "setup.complete.submit"}}</button>
  </form>
</section>