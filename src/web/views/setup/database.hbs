{{!-- SPDX-License-Identifier: MIT --}}
<header class="boot-step-head">
  <h1>{{req.t "setup.database.title"}}</h1>
  <p class="boot-lede">{{req.t "setup.database.intro"}}</p>
</header>
<h2 class="boot-section-title">{{req.t "setup.boot.connectionTitle"}}</h2>
<dl class="boot-kv">
  <div><dt>{{req.t "setup.database.hostLabel"}}</dt><dd>{{db.host}}</dd></div>
  <div><dt>{{req.t "setup.database.portLabel"}}</dt><dd>{{db.port}}</dd></div>
  <div><dt>{{req.t "setup.database.userLabel"}}</dt><dd>{{db.user}}</dd></div>
  <div><dt>{{req.t "setup.database.dbLabel"}}</dt><dd>{{db.database}}</dd></div>
</dl>
<p class="boot-note">{{req.t "setup.database.envHint"}}</p>
{{#if error}}<div class="boot-alert"><p class="form-error">{{error}}</p></div>{{/if}}
<form method="POST" action="/setup/database" class="boot-form">
  <input type="hidden" name="csrf" value="{{csrfToken}}">
  <div class="boot-actions">
    <button type="submit" class="btn-primary">{{req.t "setup.database.test"}}</button>
    <a href="/setup" class="boot-back">{{req.t "common.back"}}</a>
  </div>
</form>
