<section class="setup-step">
  <h1>Database</h1>
  <p>Current database connection:</p>
  <ul>
    <li>Host: {{db.host}}</li>
    <li>Port: {{db.port}}</li>
    <li>User: {{db.user}}</li>
    <li>Database: {{db.database}}</li>
  </ul>
  <form method="POST" action="/setup/database">
    <input type="hidden" name="csrf" value="{{csrfToken}}">
    <button type="submit" class="btn-primary">Test connection</button>
  </form>
  <p><a href="/setup">Back</a></p>
</section>
