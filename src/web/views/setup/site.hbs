<section class="setup-step">
  <h1>{{req.t 'setup.site.title'}}</h1>
  {{#if error}}<p class="form-error">{{error}}</p>{{/if}}
  <form method="POST" action="/setup/site">
    <input type="hidden" name="csrf" value="{{csrfToken}}">
    {{> form-field name="name" label=(req.t 'setup.site.nameLabel') required=true value=siteName }}
    {{> form-field name="tagline" label=(req.t 'setup.site.taglineLabel') value=siteTagline }}
    <button type="submit" class="btn-primary">{{req.t 'setup.site.submit'}}</button>
  </form>
  <p><a href="/setup/database">{{req.t 'common.back'}}</a></p>
</section>

