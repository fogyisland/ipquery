<h1>{{req.t 'dashboard.keys.title'}}</h1>
{{#if flash.success}}<div class="flash flash-success">{{flash.success}}</div>{{/if}}
{{#if flash.error}}<div class="flash flash-error">{{flash.error}}</div>{{/if}}

<section id="key-created">
  {{#if newKeyPlain}}
  <h2>{{req.t 'dashboard.keys.created_once'}}</h2>
  <p>{{req.t 'dashboard.keys.copy'}}</p>
  <input type="text" readonly value="{{newKeyPlain}}" id="key-plain">
  {{/if}}
</section>

<form method="POST" action="/dashboard/keys">
  <input type="hidden" name="csrf" value="{{req.csrfToken}}">
  {{> form-field name="label" label=(req.t 'dashboard.keys.label') required=true }}
  <button type="submit" class="btn-primary">{{req.t 'dashboard.keys.create'}}</button>
</form>

{{!-- API endpoint — the URL a user sends requests to with their key.
     Built from WEB_BASE_URL so it follows whatever site name/url the
     admin configures in site settings. --}}
<section class="endpoint-card">
  <h3 class="endpoint-card-title">{{req.t 'dashboard.keys.endpoint.title'}}</h3>
  <p class="endpoint-card-sub">{{req.t 'dashboard.keys.endpoint.help'}}</p>
  <code class="endpoint-url" id="endpoint-url">{{endpoint}}</code>
  <button type="button" class="button endpoint-copy" data-target="endpoint-url">{{req.t 'dashboard.keys.endpoint.copy'}}</button>
</section>

{{#if keys.length}}
<table class="table">
  <thead><tr><th>{{req.t 'dashboard.keys.label'}}</th><th>{{req.t 'dashboard.keys.prefix'}}</th><th>{{req.t 'dashboard.keys.lastUsed'}}</th><th>{{req.t 'dashboard.keys.created'}}</th><th></th></tr></thead>
  <tbody>
    {{#each keys}}
    <tr>
      <td>{{this.label}}</td>
      <td><code>{{this.keyPrefix}}</code></td>
      <td>{{formatRelative this.lastUsedAt}}</td>
      <td>{{formatDate this.createdAt}}</td>
      <td>
        {{#if (not this.revokedAt)}}
        <a href="/dashboard/keys/{{this.id}}/revoke/confirm">{{../req.t 'dashboard.keys.revoke'}}</a>
        {{else}}<span>(revoked)</span>{{/if}}
      </td>
    </tr>
    {{/each}}
  </tbody>
</table>
{{else}}
<p>{{req.t 'dashboard.keys.empty'}}</p>
{{/if}}

<script src="/assets/endpoint-copy.js" defer></script>
