{{!-- SPDX-License-Identifier: MIT --}}
<h1>{{req.t 'dashboard.mcp.title'}}</h1>
<p class="dash-welcome-sub">{{req.t 'dashboard.mcp.intro'}}</p>
{{#if flash.success}}<div class="flash flash-success">{{flash.success}}</div>{{/if}}
{{#if flash.error}}<div class="flash flash-error">{{flash.error}}</div>{{/if}}

{{#if newTokenPlain}}
<section id="token-created">
  <h2>{{req.t 'dashboard.mcp.createdOnce'}}</h2>
  <p>{{req.t 'dashboard.mcp.copy'}}</p>
  <input type="text" readonly value="{{newTokenPlain}}" id="token-plain">
</section>
{{/if}}

<form method="POST" action="/dashboard/mcp-tokens">
  <input type="hidden" name="csrf" value="{{req.csrfToken}}">
  {{> form-field name="label" label=(req.t 'dashboard.mcp.label') required=true }}
  {{> form-field name="scope" label=(req.t 'dashboard.mcp.scope') type="select" options=scopeOptions value=scopeSelected help=(req.t 'dashboard.mcp.scope.help') }}
  <button type="submit" class="btn-primary">{{req.t 'dashboard.mcp.request'}}</button>
</form>

{{#if clientConfig}}
<section class="endpoint-card">
  <h3 class="endpoint-card-title">{{req.t 'dashboard.mcp.clientTitle'}}</h3>
  <p class="endpoint-card-sub">{{req.t 'dashboard.mcp.clientHelp'}}</p>
  <code class="endpoint-url" id="mcp-client-config">{{clientConfig}}</code>
  <button type="button" class="button endpoint-copy" data-target="mcp-client-config">{{req.t 'dashboard.mcp.copy'}}</button>
</section>
{{/if}}

{{#if tokens.length}}
<div class="table-scroll">
  <table class="table">
    <thead>
      <tr>
        <th>{{req.t 'dashboard.mcp.label'}}</th>
        <th>{{req.t 'dashboard.mcp.scope'}}</th>
        <th>{{req.t 'dashboard.mcp.status'}}</th>
        <th>{{req.t 'dashboard.mcp.prefix'}}</th>
        <th>{{req.t 'dashboard.mcp.requestedAt'}}</th>
        <th>{{req.t 'dashboard.mcp.lastUsed'}}</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      {{#each tokens}}
      <tr>
        <td>{{this.label}}</td>
        <td>{{this.scopeLabel}}</td>
        <td>{{> pill kind=this.pillKind text=this.statusLabel}}</td>
        <td><code>{{this.tokenPrefix}}</code></td>
        <td>{{formatDate this.requestedAt}}</td>
        <td>{{formatRelative @root.req this.lastUsedAt}}</td>
        <td>
          {{#if (eq this.status "approved")}}
          <a href="/dashboard/mcp-tokens/{{this.id}}/revoke/confirm">{{../req.t 'dashboard.mcp.revokeLabel'}}</a>
          {{else}}<span>{{../req.t 'dashboard.mcp.pendingNote'}}</span>{{/if}}
        </td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</div>
{{else}}
<p>{{req.t 'dashboard.mcp.empty'}}</p>
{{/if}}

<script src="/assets/endpoint-copy.js" defer></script>
