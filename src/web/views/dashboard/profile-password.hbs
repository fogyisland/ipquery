{{!--
  The password form, on its own page.

  It asks for the CURRENT password before it will set a new one. That is
  the whole point of keeping it on a separate page: the form needs the
  old password in the same breath as the new one, and asking for both
  next to a nickname field trains people to type their password into
  the wrong box.

  On success the OTHER sessions of this account are evicted. The
  session that submitted the form survives — the person who just
  changed their password is sitting in that browser right now, and
  logging them out of it would be an act of sabotage.
--}}
<h1>{{req.t 'dashboard.profile.password.title'}}</h1>
{{#if flash.success}}<div class="flash flash-success">{{flash.success}}</div>{{/if}}
{{#if flash.error}}<div class="flash flash-error">{{flash.error}}</div>{{/if}}

<section class="card">
  <form method="POST" action="/dashboard/profile">
    <input type="hidden" name="csrf" value="{{req.csrfToken}}">
    <input type="hidden" name="action" value="password">
    {{> form-field name="oldPassword" type="password" label=(req.t 'dashboard.profile.oldPassword') required=true autocomplete="current-password" }}
    {{> form-field name="newPassword" type="password" label=(req.t 'dashboard.profile.newPassword') required=true help=(req.t 'auth.password.help') autocomplete="new-password" }}
    <button type="submit" class="btn-primary">{{req.t 'dashboard.profile.save'}}</button>
  </form>
</section>

<p class="profile-back"><a href="/dashboard/profile">{{req.t 'dashboard.profile.backToOverview'}}</a></p>
