{{!--
  /admin/providers — Strategy Definition surface.

  Consolidates three responsibilities onto one URL:
   1. Built-in provider health cards (status, last success/error, 1h/24h/7d
      window stats, quota pill, auto-re-enable countdown, last-429 detail,
      enable/disable toggle, API-key rotation).
   2. Circuit breaker config card.
   3. Custom HTTP provider CRUD (add form + list + per-IP test).

  Pure provider management — no lookup/queue/execution forms. The action
  URLs target /admin/providers/* so this view is self-contained; PR2 will
  point /admin/unknown-ips at it via a redirect.
--}}

<h2>{{req.t 'admin.providers.title'}}</h2>

{{#if (eq flash.kind 'saved')}}
<div class="admin-alert admin-alert--success">
  {{@root.req.t 'admin.unknownIps.customProviders.saved' name=flash.name}}
</div>
{{/if}}
{{#if (eq flash.kind 'deleted')}}
<div class="admin-alert admin-alert--info">
  {{@root.req.t 'admin.unknownIps.customProviders.deleted' name=flash.name}}
</div>
{{/if}}
{{#if (eq flash.kind 'error')}}
<div class="admin-alert admin-alert--danger">
  {{flash.message}}
</div>
{{/if}}

<h3>{{req.t 'admin.providers.builtInSection'}}</h3>
<div class="provider-health-list">
  {{#each providerHealth}}
  {{!-- A provider card answers one question: is this source worth keeping
       on? Health sits on the left, the controls that change it on the
       right, so the two are read together rather than scrolled between.
       The window figures lead with the failure rate because that is the
       number the question turns on; raw call counts stay in the tooltip. --}}
  <div class="provider-health-card provider-health-card--{{this.status}}">
    <div class="provider-health-card-head">
      <div class="provider-health-card-id">
        <span class="provider-health-card-name">{{this.displayName}}</span>
        <span class="provider-health-card-meta">
          <code class="provider-health-card-slug">{{this.name}}</code>
          <span class="provider-health-card-sep">·</span>
          <span>{{this.freeQuota}}</span>
        </span>
      </div>
      <div class="provider-health-card-flags">
        {{#if this.enabled}}
          <span class="provider-flag provider-flag--on">{{@root.req.t 'admin.providers.enabledChip'}}</span>
        {{else}}
          <span class="provider-flag provider-flag--off">{{@root.req.t 'admin.providers.disabledChip'}}</span>
        {{/if}}
        <span class="provider-health-status provider-health-status--{{this.status}}">
          {{#if (eq this.status 'healthy')}}{{@root.req.t 'admin.unknownIps.healthCard.statusOk'}}
          {{else if (eq this.status 'failing')}}{{@root.req.t 'admin.unknownIps.healthCard.statusFailing'}}
          {{else if (eq this.status 'recovering')}}{{@root.req.t 'admin.unknownIps.healthCard.statusRecovering'}}
          {{else if (eq this.status 'disabled')}}{{@root.req.t 'admin.unknownIps.healthCard.statusDisabled'}}
          {{else}}{{@root.req.t 'admin.unknownIps.healthCard.statusIdle'}}{{/if}}
        </span>
      </div>
    </div>

    <div class="provider-health-card-body">
      <div class="provider-health-card-left">
        {{#if this.hasAnyCalls}}
        <div class="provider-health-window">
          <div class="provider-health-window-cell provider-health-window-cell--{{this.health1h.kind}}" title="{{this.health1h.title}}">
            <div class="provider-health-window-label">{{@root.req.t 'admin.unknownIps.healthCard.window1h'}}</div>
            <div class="provider-health-window-figure">{{this.health1h.failurePct}}<span class="provider-health-window-unit">%</span></div>
            <div class="provider-health-window-sub">{{this.health1h.calls}} {{@root.req.t 'admin.unknownIps.healthCard.calls'}}</div>
          </div>
          <div class="provider-health-window-cell provider-health-window-cell--{{this.health24h.kind}}" title="{{this.health24h.title}}">
            <div class="provider-health-window-label">{{@root.req.t 'admin.unknownIps.healthCard.window24h'}}</div>
            <div class="provider-health-window-figure">{{this.health24h.failurePct}}<span class="provider-health-window-unit">%</span></div>
            <div class="provider-health-window-sub">{{this.health24h.calls}} {{@root.req.t 'admin.unknownIps.healthCard.calls'}}</div>
          </div>
          <div class="provider-health-window-cell provider-health-window-cell--{{this.health7d.kind}}" title="{{this.health7d.title}}">
            <div class="provider-health-window-label">{{@root.req.t 'admin.unknownIps.healthCard.window7d'}}</div>
            <div class="provider-health-window-figure">{{this.health7d.failurePct}}<span class="provider-health-window-unit">%</span></div>
            <div class="provider-health-window-sub">{{this.health7d.calls}} {{@root.req.t 'admin.unknownIps.healthCard.calls'}}</div>
          </div>
        </div>
        {{else}}
        <div class="provider-health-empty">
          <span class="provider-health-empty-title">{{@root.req.t 'admin.providers.neverRun'}}</span>
          <span class="provider-health-empty-hint">{{@root.req.t 'admin.providers.neverRunHint'}}</span>
        </div>
        {{/if}}

        <div class="provider-health-card-facts">
          <span class="provider-fact">
            <span class="provider-fact-label">{{@root.req.t 'admin.unknownIps.healthCard.lastSuccess'}}</span>
            {{#if this.lastUsedAt}}<span title="{{formatDate this.lastUsedAt}}">{{formatRelative @root.req this.lastUsedAt}}</span>
            {{else}}<span class="provider-fact-none">{{@root.req.t 'admin.unknownIps.healthCard.noSuccess'}}</span>{{/if}}
          </span>
          <span class="provider-fact">
            <span class="provider-fact-label">{{@root.req.t 'admin.unknownIps.healthCard.lastError'}}</span>
            {{#if this.lastErrorAt}}<span class="provider-health-error-text" title="{{this.lastErrorReason}}">{{formatRelative @root.req this.lastErrorAt}}</span>
            {{else}}<span class="provider-fact-none">{{@root.req.t 'admin.unknownIps.healthCard.noError'}}</span>{{/if}}
          </span>
          {{#if this.lastStats}}
          <span class="provider-fact">
            <span class="provider-fact-label">{{@root.req.t 'admin.unknownIps.healthCard.lastRun'}}</span>
            <span>{{this.lastStats.ok}} / {{this.lastStats.failed}}{{#if this.lastStats.rateLimited}} / {{this.lastStats.rateLimited}} 429{{/if}}</span>
          </span>
          {{/if}}
        </div>

        {{#if this.lastErrorReason}}
        <div class="provider-health-card-error" title="{{this.lastErrorReason}}">{{this.lastErrorReason}}</div>
        {{/if}}

        {{#if this.lastError}}
        <details class="provider-last-error">
          <summary>{{@root.req.t 'admin.unknownIps.healthCard.last429'}}</summary>
          <pre>{{this.lastError.rawResponse}}</pre>
          <small>{{formatDate this.lastError.ts}} - {{this.lastError.ipText}}</small>
        </details>
        {{/if}}
      </div>

      <div class="provider-health-card-right">
        {{#if this.quotaTodayText}}
        <div class="provider-health-card-quota-row">
          {{> pill kind=this.quotaKind text=this.quotaTodayText}}
          {{#if this.autoReenableAt}}{{#unless this.enabled}}
            {{> pill kind=this.reenableKind text=this.reenableText}}
          {{/unless}}{{/if}}
        </div>
        {{else}}
          {{#if this.autoReenableAt}}{{#unless this.enabled}}
          <div class="provider-health-card-quota-row">
            {{> pill kind=this.reenableKind text=this.reenableText}}
          </div>
          {{/unless}}{{/if}}
        {{/if}}

        {{!-- One form, one button. The toggle and the key used to be two
             separate forms each carrying its own save, so toggling and then
             pressing the key's button silently reverted the toggle. --}}
        <form method="POST" action="/admin/providers/{{this.name}}" class="provider-settings-form">
          <input type="hidden" name="csrf" value="{{csrfToken}}">
          <label class="provider-toggle">
            <input type="checkbox" name="enabled" value="on" {{#if this.enabled}}checked{{/if}}>
            <span>{{#if this.enabled}}{{@root.req.t 'admin.unknownIps.providers.enabled.on'}}{{else}}{{@root.req.t 'admin.unknownIps.providers.enabled.off'}}{{/if}}</span>
          </label>
          <label class="provider-key-field">
            <span class="provider-key-field-label">{{@root.req.t 'admin.providers.apiKeyLabel'}}</span>
            {{!-- Write-only: the stored key is never echoed back. The
                 placeholder is the only signal that one exists, and the
                 field is required until it does — otherwise saving with a
                 blank key stores nothing and looks like it worked. --}}
            <input type="password" name="apiKey" {{#unless this.hasApiKey}}required{{/unless}}
                   title="{{#if this.hasApiKey}}{{@root.req.t 'admin.providers.apiKeyStored'}}{{else}}{{@root.req.t 'admin.unknownIps.providers.saveWithKey'}}{{/if}}"
                   placeholder="{{#if this.hasApiKey}}{{@root.req.t 'admin.providers.apiKeyStored'}}{{else}}{{@root.req.t 'admin.unknownIps.providers.apiKeyPlaceholder'}}{{/if}}"
                   autocomplete="off">
          </label>
          <button type="submit" class="btn-primary btn-sm">{{@root.req.t 'admin.providers.save'}}</button>
        </form>

        {{#if this.enforcedLimit}}
        {{!-- The chip is reserved for the one place a limit is actually
             enforced. Quotas the provider merely publishes are already on
             the card head, and a "no limit" chip says nothing. --}}
        <div class="provider-health-card-limits">
          <span class="provider-limit-chip provider-limit-chip--enforced" title="{{@root.req.t 'admin.providers.enforcedChipTitle'}}">
            {{this.enforcedLimit}}
          </span>
        </div>
        {{/if}}
      </div>
    </div>
  </div>
  {{/each}}
</div>

<h3>{{req.t 'admin.providers.circuitBreakerSection'}}</h3>
<div class="circuit-breaker-card">
  <h3>{{@root.req.t 'admin.unknownIps.circuitBreaker.title'}}</h3>
  <p class="circuit-breaker-help">{{@root.req.t 'admin.unknownIps.circuitBreaker.help'}}</p>
  <form method="POST" action="/admin/providers/circuit-breaker" class="circuit-breaker-form">
    <input type="hidden" name="csrf" value="{{csrfToken}}">
    <label class="provider-toggle">
      <input type="checkbox" name="enabled" value="on" {{#if circuitBreaker.enabled}}checked{{/if}}>
      <span>{{@root.req.t 'admin.unknownIps.circuitBreaker.enabled'}}</span>
    </label>
    <div class="circuit-breaker-row">
      <label>
        <span>{{@root.req.t 'admin.unknownIps.circuitBreaker.threshold'}}</span>
        <input type="number" name="threshold" min="1" max="100" value="{{circuitBreaker.failureThresholdPct}}">
      </label>
      <label>
        <span>{{@root.req.t 'admin.unknownIps.circuitBreaker.window'}}</span>
        <input type="number" name="window" min="1" max="1440" value="{{circuitBreaker.windowMinutes}}">
      </label>
      <label>
        <span>{{@root.req.t 'admin.unknownIps.circuitBreaker.cooldown'}}</span>
        <input type="number" name="cooldown" min="1" max="1440" value="{{circuitBreaker.cooldownMinutes}}">
      </label>
    </div>
    <button type="submit" class="btn-primary">{{@root.req.t 'admin.unknownIps.circuitBreaker.save'}}</button>
  </form>
</div>

<h3>{{req.t 'admin.providers.customSection'}}</h3>
<p class="admin-section-help">{{@root.req.t 'admin.unknownIps.customProviders.addTitle'}}</p>
<form method="POST" action="/admin/providers/custom" class="custom-provider-form">
  <input type="hidden" name="csrf" value="{{csrfToken}}">
  <div class="custom-provider-form-grid">
    <label>
      <span>{{@root.req.t 'admin.unknownIps.customProviders.name'}}</span>
      <input type="text" name="name" pattern="[a-z][a-z0-9_\-]{0,31}" required>
      <small class="form-hint">{{@root.req.t 'admin.unknownIps.customProviders.nameHint'}}</small>
    </label>
    <label>
      <span>{{@root.req.t 'admin.unknownIps.customProviders.displayName'}}</span>
      <input type="text" name="displayName">
    </label>
    <label class="custom-provider-form-grid-full">
      <span>{{@root.req.t 'admin.unknownIps.customProviders.urlTemplate'}}</span>
      <input type="text" name="urlTemplate" placeholder="https://api.example.com/{ip}?key={apiKey}" required>
      <small class="form-hint">{{@root.req.t 'admin.unknownIps.customProviders.urlTemplateHint'}}</small>
    </label>
    <label>
      <span>{{@root.req.t 'admin.unknownIps.customProviders.method'}}</span>
      <select name="method">
        <option value="GET">{{@root.req.t 'admin.unknownIps.customProviders.methodGet'}}</option>
        <option value="POST">{{@root.req.t 'admin.unknownIps.customProviders.methodPost'}}</option>
      </select>
    </label>
    <label>
      <span>{{@root.req.t 'admin.unknownIps.customProviders.responseFormat'}}</span>
      <select name="responseFormat">
        <option value="json">JSON</option>
        <option value="text">Text</option>
      </select>
    </label>
    <label>
      <span>{{@root.req.t 'admin.unknownIps.customProviders.countryPath'}}</span>
      <input type="text" name="countryPath" placeholder="country.code" required>
    </label>
    <label>
      <span>{{@root.req.t 'admin.unknownIps.customProviders.cityPath'}}</span>
      <input type="text" name="cityPath" placeholder="city.name">
    </label>
    <label>
      <span>{{@root.req.t 'admin.unknownIps.customProviders.asnPath'}}</span>
      <input type="text" name="asnPath" placeholder="asn">
    </label>
    <label>
      <span>{{@root.req.t 'admin.unknownIps.customProviders.timeoutMs'}}</span>
      <input type="number" name="timeoutMs" min="100" max="30000" value="5000">
    </label>
    <label class="custom-provider-form-grid-full">
      <span>{{@root.req.t 'admin.unknownIps.customProviders.requestBody'}}</span>
      <textarea name="requestBody" rows="2" placeholder='{"ip":"{ip}","key":"{apiKey}"}'></textarea>
    </label>
    <label>
      <span>{{@root.req.t 'admin.providers.apiKeyLabel'}}</span>
      <input type="password" name="apiKey" autocomplete="off" placeholder="{{@root.req.t 'admin.unknownIps.providers.apiKeyPlaceholder'}}">
    </label>
    <label class="provider-toggle">
      <input type="checkbox" name="enabled" value="on" checked>
      <span>{{@root.req.t 'admin.unknownIps.customProviders.enabled'}}</span>
    </label>
  </div>
  <div class="custom-provider-form-actions">
    <button type="submit" class="btn-primary">{{@root.req.t 'admin.unknownIps.customProviders.save'}}</button>
  </div>
</form>

<h3>{{@root.req.t 'admin.unknownIps.customProviders.listTitle'}}</h3>
{{#if customProviders.length}}
<div class="custom-providers-list">
  {{#each customProviders}}
  <div class="provider-health-card provider-health-card--{{#if this.enabled}}idle{{else}}disabled{{/if}}">
    <div class="provider-health-card-head">
      <div>
        <span class="provider-health-card-name">{{this.displayName}}</span>
        <code class="provider-health-card-slug">{{this.name}}</code>
      </div>
      <span class="provider-health-status provider-health-status--{{#if this.enabled}}idle{{else}}disabled{{/if}}">
        {{#if this.enabled}}{{@root.req.t 'admin.unknownIps.healthCard.statusIdle'}}
        {{else}}{{@root.req.t 'admin.unknownIps.healthCard.statusDisabled'}}{{/if}}
      </span>
    </div>

    <div class="provider-health-card-grid">
      <div class="provider-health-stat provider-health-stat--wide">
        <span class="provider-health-stat-label">{{@root.req.t 'admin.unknownIps.customProviders.apiCol'}}</span>
        <span class="provider-health-stat-value"><code>{{this.urlTemplate}}</code></span>
      </div>
      <div class="provider-health-stat">
        <span class="provider-health-stat-label">{{@root.req.t 'admin.unknownIps.customProviders.methodCol'}}</span>
        <span class="provider-health-stat-value">{{this.method}} · {{this.responseFormat}}</span>
      </div>
      <div class="provider-health-stat">
        <span class="provider-health-stat-label">{{@root.req.t 'admin.unknownIps.customProviders.countryPath'}}</span>
        <span class="provider-health-stat-value"><code>{{this.countryPath}}</code></span>
      </div>
    </div>

    <div class="provider-health-window">
      <div class="provider-health-window-cell">
        <div class="provider-health-window-label">{{@root.req.t 'admin.unknownIps.healthCard.window1h'}}</div>
        <div class="provider-health-window-figure">{{this.health1h.failurePct}}<span class="provider-health-window-unit">%</span></div>
        <div class="provider-health-window-sub">{{this.health1h.calls}} {{@root.req.t 'admin.unknownIps.healthCard.calls'}} · {{this.health1h.errors429}} 429</div>
      </div>
      <div class="provider-health-window-cell">
        <div class="provider-health-window-label">{{@root.req.t 'admin.unknownIps.healthCard.window24h'}}</div>
        <div class="provider-health-window-figure">{{this.health24h.failurePct}}<span class="provider-health-window-unit">%</span></div>
        <div class="provider-health-window-sub">{{this.health24h.calls}} {{@root.req.t 'admin.unknownIps.healthCard.calls'}} · {{this.health24h.errors429}} 429</div>
      </div>
      <div class="provider-health-window-cell">
        <div class="provider-health-window-label">{{@root.req.t 'admin.unknownIps.healthCard.window7d'}}</div>
        <div class="provider-health-window-figure">{{this.health7d.failurePct}}<span class="provider-health-window-unit">%</span></div>
        <div class="provider-health-window-sub">{{this.health7d.calls}} {{@root.req.t 'admin.unknownIps.healthCard.calls'}} · {{this.health7d.errors429}} 429</div>
      </div>
    </div>

    <div class="custom-provider-actions">
      <form method="POST" action="/admin/providers/custom/{{this.name}}/delete" class="inline-form"
            data-confirm="{{@root.req.t 'admin.unknownIps.customProviders.deleteConfirm' name=this.name}}">
        <input type="hidden" name="csrf" value="{{@root.csrfToken}}">
        <button type="submit" class="button">{{@root.req.t 'admin.unknownIps.customProviders.delete'}}</button>
      </form>
      <form method="POST" action="/admin/providers/custom/{{this.name}}/test" class="custom-provider-test-form">
        <input type="hidden" name="csrf" value="{{@root.csrfToken}}">
        <input type="text" name="ip" placeholder="{{@root.req.t 'admin.unknownIps.customProviders.testIp'}}"
               aria-label="{{@root.req.t 'admin.unknownIps.customProviders.testIp'}}" required>
        <button type="submit" class="button">{{@root.req.t 'admin.unknownIps.customProviders.test'}}</button>
      </form>
      <code class="custom-provider-test-result" id="test-result-{{this.name}}"></code>
    </div>
  </div>
  {{/each}}
</div>
{{else}}
<p class="admin-empty">{{@root.req.t 'admin.unknownIps.customProviders.empty'}}</p>
{{/if}}

<script src="/assets/custom-providers-test.js" defer></script>
