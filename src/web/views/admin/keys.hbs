<h2>{{req.t 'admin.keys.title'}}</h2>

{{> filter-bar action='/admin/keys' filters=(array
  (hash name='revoked' label=(req.t 'admin.keys.col.revoked') options=(array (hash value='yes' label=(req.t 'admin.keys.option-revoked-yes')) (hash value='no' label=(req.t 'admin.keys.option-revoked-no'))))
) values=filters csvUrl='/admin/keys.csv' anyLabel=(req.t 'common.any') filterLabel=(req.t 'common.filter') exportLabel=(req.t 'common.exportCsv')}}

{{!-- Bulk action bar: lives outside the table so it can sit alongside
     pagination. The form's action is /admin/keys/revoke-bulk (CSRF-gated).
     Admin ticks per-row checkboxes (.keys-check-row); "Select all" toggles
     every active key (already-revoked keys are not checkable — we skip
     the checkbox entirely in the markup below). Submit is disabled until
     at least one row is checked; the inline script wires it up. --}}
<div class="keys-bulk-bar">
  <form id="keys-bulk-form" method="POST" action="/admin/keys/revoke-bulk"
        data-confirm="{{@root.req.t 'admin.keys.bulkRevokeConfirm'}}">
    <input type="hidden" name="csrf" value="{{csrfToken}}">
    <button type="submit" class="btn-secondary" id="keys-bulk-btn" disabled>
      {{@root.req.t 'admin.keys.bulkRevoke'}} (<span id="keys-bulk-count">0</span>)
    </button>
  </form>
</div>

<div class="table-scroll">
  <table class="table">
    <thead>
      <tr>
        <th class="table-check"><input type="checkbox" id="keys-check-all" aria-label="{{@root.req.t 'admin.keys.bulkSelectAll'}}"></th>
        {{> sort-link column=(lookupColumn sortColumns 'id') label=(req.t 'admin.keys.col.id')}}
        <th>{{req.t 'admin.keys.col.owner'}}</th>
        {{> sort-link column=(lookupColumn sortColumns 'label') label=(req.t 'admin.keys.col.label')}}
        {{> sort-link column=(lookupColumn sortColumns 'key_prefix') label=(req.t 'admin.keys.col.prefix')}}
        {{> sort-link column=(lookupColumn sortColumns 'created_at') label=(req.t 'admin.keys.col.created')}}
        <th>{{req.t 'admin.keys.col.revoked'}}</th>
      </tr>
    </thead>
    <tbody>
      {{#each keys}}
      <tr>
        <td class="table-check">
          {{#unless this.revokedAt}}<input type="checkbox" name="ids" value="{{this.id}}" form="keys-bulk-form" class="keys-check-row" aria-label="{{@root.req.t 'admin.keys.bulkSelectOne' id=this.id}}">{{/unless}}
        </td>
        <td class="table-num">{{this.id}}</td>
        <td>{{this.ownerEmail}}</td>
        <td>{{this.label}}</td>
        <td><code>{{this.keyPrefix}}</code></td>
        <td class="table-num">{{formatDate this.createdAt}}</td>
        <td class="table-num">{{#if this.revokedAt}}{{formatDate this.revokedAt}}{{else}}—{{/if}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</div>

<script src="/assets/keys-bulk.js" defer></script>

{{> pagination baseUrl="/admin/keys" page=page totalPages=totalPages queryString=queryString }}