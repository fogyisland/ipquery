<h2>{{req.t 'admin.keys.title'}}</h2>

{{> filter-bar action='/admin/keys' filters=(array
  (hash name='revoked' label=(req.t 'admin.keys.col.revoked') options=(array (hash value='yes' label=(req.t 'admin.keys.option-revoked-yes')) (hash value='no' label=(req.t 'admin.keys.option-revoked-no'))))
) values=filters csvUrl='/admin/keys.csv' anyLabel=(req.t 'common.any') filterLabel=(req.t 'common.filter') exportLabel=(req.t 'common.exportCsv')}}

{{!-- Bulk action bar: lives outside the table so it can sit alongside
     pagination. The form's action is /admin/keys/revoke-bulk (CSRF-gated).
     Admin ticks per-row checkboxes (.keys-check-row); "Select all" toggles
     every active key (already-revoked keys are not checkable — we skip
     the checkbox entirely in the markup below). Submit is disabled until
     at least one row is checked; the inline script wires it up. --}}
<div class="keys-bulk-bar">
  <form id="keys-bulk-form" method="POST" action="/admin/keys/revoke-bulk"
        onsubmit="return confirm('{{@root.req.t 'admin.keys.bulkRevokeConfirm'}}')">
    <input type="hidden" name="csrf" value="{{csrfToken}}">
    <button type="submit" class="btn-secondary" id="keys-bulk-btn" disabled>
      {{@root.req.t 'admin.keys.bulkRevoke'}} (<span id="keys-bulk-count">0</span>)
    </button>
  </form>
</div>

<table class="table">
  <thead>
    <tr>
      <th class="table-check"><input type="checkbox" id="keys-check-all" aria-label="{{@root.req.t 'admin.keys.bulkSelectAll'}}"></th>
      <th><a href="?sort={{ternary (eq sort.col 'id') (ternary (eq sort.dir 'asc') '-id' 'id') (ternary (eq sort.dir 'asc') 'id' '-id')}}">{{req.t 'admin.keys.col.id'}}</a></th>
      <th>{{req.t 'admin.keys.col.owner'}}</th>
      <th><a href="?sort={{ternary (eq sort.col 'label') (ternary (eq sort.dir 'asc') '-label' 'label') (ternary (eq sort.dir 'asc') 'label' '-label')}}">{{req.t 'admin.keys.col.label'}}</a></th>
      <th><a href="?sort={{ternary (eq sort.col 'key_prefix') (ternary (eq sort.dir 'asc') '-key_prefix' 'key_prefix') (ternary (eq sort.dir 'asc') 'key_prefix' '-key_prefix')}}">{{req.t 'admin.keys.col.prefix'}}</a></th>
      <th><a href="?sort={{ternary (eq sort.col 'created_at') (ternary (eq sort.dir 'asc') '-created_at' 'created_at') (ternary (eq sort.dir 'asc') 'created_at' '-created_at')}}">{{req.t 'admin.keys.col.created'}}</a></th>
      <th>{{req.t 'admin.keys.col.revoked'}}</th>
    </tr>
  </thead>
  <tbody>
    {{#each keys}}
    <tr>
      <td class="table-check">
        {{#unless this.revokedAt}}<input type="checkbox" name="ids" value="{{this.id}}" form="keys-bulk-form" class="keys-check-row" aria-label="{{@root.req.t 'admin.keys.bulkSelectOne' id=this.id}}">{{/unless}}
      </td>
      <td class="table-num">{{this.id}}</td>
      <td>{{this.ownerEmail}}</td>
      <td>{{this.label}}</td>
      <td><code>{{this.keyPrefix}}</code></td>
      <td class="table-num">{{formatDate this.createdAt}}</td>
      <td class="table-num">{{#if this.revokedAt}}{{formatDate this.revokedAt}}{{else}}—{{/if}}</td>
    </tr>
    {{/each}}
  </tbody>
</table>

<script>
(function() {
  // Bulk-select wiring for the API keys table. The "select all" checkbox
  // toggles every per-row checkbox; per-row checkboxes update the count
  // badge and enable/disable the submit button. Already-revoked rows
  // don't emit a checkbox at all (see the unless-this.revokedAt guard
  // in the table body), so they're naturally excluded from the bulk action.
  var checkAll = document.getElementById('keys-check-all');
  var rows = document.querySelectorAll('.keys-check-row');
  var btn = document.getElementById('keys-bulk-btn');
  var count = document.getElementById('keys-bulk-count');
  function update() {
    var n = 0;
    rows.forEach(function(r) { if (r.checked) n++; });
    if (count) count.textContent = String(n);
    if (btn) btn.disabled = n === 0;
    if (checkAll) {
      if (n === 0) { checkAll.indeterminate = false; checkAll.checked = false; }
      else if (n === rows.length) { checkAll.indeterminate = false; checkAll.checked = true; }
      else checkAll.indeterminate = true;
    }
  }
  if (checkAll) checkAll.addEventListener('change', function() {
    rows.forEach(function(r) { r.checked = checkAll.checked; });
    update();
  });
  rows.forEach(function(r) { r.addEventListener('change', update); });
  update();
})();
</script>

{{> pagination baseUrl="/admin/keys" page=page totalPages=totalPages queryString=queryString }}