{{!-- /admin/unknown-ips — list IPs the local DB couldn't resolve, sorted by
     how often users ask for them (queue pressure). The "立即回灌" button
     kicks off the backfill job: each IP fans out to 3 external providers,
     majority-vote decides the result, and a /32 or /128 range gets
     upserted into ip_ranges tagged 'multi-provider'.

     Data flow: /lookup miss → unknown_ip_queue (auto) → here (manual) →
     POST /admin/unknown-ips/backfill → ip_ranges.

     After the POST the route sets a short-lived `backfill_summary` cookie
     that this view reads once and renders as a banner. --}}

<section class="admin-card">
  <div class="admin-card-head">
    <h1>{{req.t 'admin.unknownIps.title'}}</h1>
    <div class="admin-card-actions">
      <form method="GET" action="/admin/unknown-ips/backfill/confirm" style="display:inline">
        <button type="submit" class="btn-primary">{{req.t 'admin.unknownIps.backfill.button'}}</button>
      </form>
      <form method="POST" action="/admin/unknown-ips/generate" style="display:inline"
            onsubmit="return confirm('{{req.t 'admin.unknownIps.generate.confirm'}}')">
        <input type="hidden" name="csrf" value="{{csrfToken}}">
        <input type="hidden" name="count" value="10">
        <button type="submit" class="btn-secondary">{{req.t 'admin.unknownIps.generate.button'}}</button>
      </form>
    </div>
  </div>

  {{#if flash.backfillSummary}}
  <div class="admin-alert admin-alert--success">
    <strong>{{req.t 'admin.unknownIps.backfill.summary'}}</strong>
    <ul class="admin-summary-list">
      <li>{{req.t 'admin.unknownIps.backfill.considered'}}: {{flash.backfillSummary.considered}}</li>
      <li>{{req.t 'admin.unknownIps.backfill.merged'}}: {{flash.backfillSummary.merged}}</li>
      <li>{{req.t 'admin.unknownIps.backfill.noConsensus'}}: {{flash.backfillSummary.noConsensus}}</li>
      <li>{{req.t 'admin.unknownIps.backfill.noCountry'}}: {{flash.backfillSummary.noCountry}}</li>
      <li>{{req.t 'admin.unknownIps.backfill.allAbstained'}}: {{flash.backfillSummary.allAbstained}}</li>
    </ul>
  </div>
  {{/if}}

  {{#if flash.generateSummary}}
  <div class="admin-alert admin-alert--info">
    <strong>{{req.t 'admin.unknownIps.generate.summary'}}</strong>
    <ul class="admin-summary-list">
      <li>{{req.t 'admin.unknownIps.generate.considered'}}: {{flash.generateSummary.considered}}</li>
      <li>{{req.t 'admin.unknownIps.generate.merged'}}: {{flash.generateSummary.merged}}</li>
      <li>{{req.t 'admin.unknownIps.generate.noConsensus'}}: {{flash.generateSummary.noConsensus}}</li>
      <li>{{req.t 'admin.unknownIps.generate.noCountry'}}: {{flash.generateSummary.noCountry}}</li>
      <li>{{req.t 'admin.unknownIps.generate.allAbstained'}}: {{flash.generateSummary.allAbstained}}</li>
      <li>{{req.t 'admin.unknownIps.generate.exhaustedRetries'}}: {{flash.generateSummary.exhaustedRetries}}</li>
      {{#if flash.generateSummary.providersDisabled.length}}
      <li class="admin-summary-disabled">
        {{req.t 'admin.unknownIps.generate.providersDisabled'}}: {{flash.generateSummary.providersDisabled}}
      </li>
      {{/if}}
      {{#if flash.generateSummary.generatedIps.length}}
      <li class="admin-summary-ips">
        <details>
          <summary>{{req.t 'admin.unknownIps.generate.ipList'}}</summary>
          <code class="admin-ips">{{flash.generateSummary.generatedIps}}</code>
        </details>
      </li>
      {{/if}}
    </ul>
  </div>
  {{/if}}

  {{!-- Continuous random-IP ingest toggle. When enabled, the runner ticks
       every 60s and runs runRandomGeneration() with count=10. The runner
       is a separate plugin (src/web/plugins/randomIpGeneratorRunner.ts).
       State persists in `settings` table so a server restart resumes the
       previous toggle state. --}}
  {{#if randomGenState}}
  <div class="admin-continuous-card">
    <div class="admin-continuous-head">
      <h3>{{req.t 'admin.unknownIps.continuous.title'}}</h3>
      <span class="admin-continuous-status admin-continuous-status--{{#if randomGenState.enabled}}on{{else}}off{{/if}}">
        {{#if randomGenState.enabled}}
          {{req.t 'admin.unknownIps.continuous.enabled'}}
        {{else}}
          {{req.t 'admin.unknownIps.continuous.disabled'}}
        {{/if}}
      </span>
    </div>
    <p class="admin-continuous-help">{{req.t 'admin.unknownIps.continuous.help'}}</p>

    <div class="admin-continuous-meta">
      <div class="admin-continuous-meta-row">
        <span class="admin-continuous-meta-label">{{req.t 'admin.unknownIps.continuous.lastRunAt'}}</span>
        {{#if randomGenState.lastRunAt}}
          <span class="admin-continuous-meta-value" title="{{randomGenState.lastRunAt}}">{{formatRelative randomGenState.lastRunAt}}</span>
        {{else}}
          <span class="admin-continuous-meta-value admin-tag admin-tag--muted">{{req.t 'admin.unknownIps.continuous.lastRunNever'}}</span>
        {{/if}}
      </div>
      {{#if randomGenState.lastSummary}}
      <div class="admin-continuous-meta-row">
        <span class="admin-continuous-meta-label">{{req.t 'admin.unknownIps.continuous.status'}}</span>
        <span class="admin-continuous-meta-value">
          {{req.t 'admin.unknownIps.continuous.lastSummaryMerged' merged=randomGenState.lastSummary.merged considered=randomGenState.lastSummary.considered}}
        </span>
      </div>
      {{/if}}
    </div>

    <div class="admin-continuous-actions">
      <form method="POST" action="/admin/unknown-ips/generate/continuous" style="display:inline">
        <input type="hidden" name="csrf" value="{{csrfToken}}">
        <input type="hidden" name="enabled" value="{{#if randomGenState.enabled}}off{{else}}on{{/if}}">
        <button type="submit" class="btn-{{#if randomGenState.enabled}}secondary{{else}}primary{{/if}}">
          {{#if randomGenState.enabled}}{{req.t 'admin.unknownIps.continuous.disable'}}{{else}}{{req.t 'admin.unknownIps.continuous.enable'}}{{/if}}
        </button>
      </form>
      <form method="POST" action="/admin/unknown-ips/generate/continuous" style="display:inline">
        <input type="hidden" name="csrf" value="{{csrfToken}}">
        <input type="hidden" name="kick" value="1">
        <button type="submit" class="btn-secondary">{{req.t 'admin.unknownIps.continuous.kickNow'}}</button>
      </form>
    </div>
  </div>
  {{/if}}

  <div class="admin-stats">
    <div class="admin-stat">
      <span class="admin-stat-value">{{stats.pending}}</span>
      <span class="admin-stat-label">{{req.t 'admin.unknownIps.stats.pending'}}</span>
    </div>
    <div class="admin-stat">
      <span class="admin-stat-value">{{stats.processed}}</span>
      <span class="admin-stat-label">{{req.t 'admin.unknownIps.stats.processed'}}</span>
    </div>
    <div class="admin-stat">
      <span class="admin-stat-value">{{stats.totalQueries}}</span>
      <span class="admin-stat-label">{{req.t 'admin.unknownIps.stats.totalQueries'}}</span>
    </div>
  </div>

  <h2>{{req.t 'admin.unknownIps.section.pending'}}</h2>
  {{#if pending.length}}
  <table class="admin-table">
    <thead>
      <tr>
        <th>{{req.t 'admin.unknownIps.col.ip'}}</th>
        <th>{{req.t 'admin.unknownIps.col.queryCount'}}</th>
        <th>{{req.t 'admin.unknownIps.col.firstSeen'}}</th>
        <th>{{req.t 'admin.unknownIps.col.lastSeen'}}</th>
        <th>{{req.t 'admin.unknownIps.col.source'}}</th>
        <th>{{req.t 'admin.unknownIps.col.lastAttempt'}}</th>
      </tr>
    </thead>
    <tbody>
      {{#each pending}}
      <tr>
        <td><code>{{this.ipText}}</code></td>
        <td>{{this.queryCount}}</td>
        <td>{{formatDate this.firstSeenAt}}</td>
        <td>{{formatDate this.lastSeenAt}}</td>
        <td><span class="admin-tag admin-tag--{{this.source}}">{{this.source}}</span></td>
        <td>
          {{#if this.lastAttemptReason}}
            <span class="admin-tag admin-tag--warn">{{this.lastAttemptReason}}</span>
          {{else}}
            —
          {{/if}}
        </td>
      </tr>
      {{/each}}
    </tbody>
  </table>
  {{else}}
  <p class="admin-empty">{{req.t 'admin.unknownIps.empty.pending'}}</p>
  {{/if}}

  {{#if recentlyProcessed.length}}
  <h2>{{req.t 'admin.unknownIps.section.recentlyProcessed'}}</h2>
  <table class="admin-table">
    <thead>
      <tr>
        <th>{{req.t 'admin.unknownIps.col.ip'}}</th>
        <th>{{req.t 'admin.unknownIps.col.queryCount'}}</th>
        <th>{{req.t 'admin.unknownIps.col.processedAt'}}</th>
        <th>{{req.t 'admin.unknownIps.col.runId'}}</th>
      </tr>
    </thead>
    <tbody>
      {{#each recentlyProcessed}}
      <tr>
        <td><code>{{this.ipText}}</code></td>
        <td>{{this.queryCount}}</td>
        <td>{{formatDate this.processedAt}}</td>
        <td>{{#if this.mergedRunId}}{{this.mergedRunId}}{{else}}<span class="admin-tag admin-tag--muted">{{req.t 'admin.unknownIps.runId.manual'}}</span>{{/if}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>
  {{/if}}
</section>

{{!-- Provider config. Each row shows the free-tier quota and lets the
     admin flip the enabled toggle + set/clear the api_key. The catalog
     (which providers exist + their display name) is code-managed; only
     enabled / api_key are persisted from this form. --}}
<section class="admin-card">
  <div class="admin-card-head">
    <h2>{{req.t 'admin.unknownIps.providers.title'}}</h2>
    <p class="admin-card-sub">{{req.t 'admin.unknownIps.providers.help'}}</p>
  </div>

  <table class="admin-table provider-table">
    <thead>
      <tr>
        <th>{{req.t 'admin.unknownIps.providers.col.name'}}</th>
        <th>{{req.t 'admin.unknownIps.providers.col.quota'}}</th>
        <th>{{req.t 'admin.unknownIps.providers.col.enabled'}}</th>
        <th>{{req.t 'admin.unknownIps.providers.col.apiKey'}}</th>
        <th>{{req.t 'admin.unknownIps.providers.col.lastUsed'}}</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      {{#each providers}}
      <tr>
        <td>
          <strong>{{this.displayName}}</strong>
          <div class="provider-table-meta">{{this.name}}</div>
        </td>
        <td><code class="provider-table-quota">{{this.freeQuota}}</code></td>
        <td>
          <form method="POST" action="/admin/unknown-ips/providers/{{this.name}}" class="provider-toggle-form">
            <input type="hidden" name="csrf" value="{{../csrfToken}}">
            <input type="hidden" name="apiKey" value="{{this.apiKey}}">
            <label class="provider-toggle">
              <input type="checkbox" name="enabled" value="on" {{#if this.enabled}}checked{{/if}}>
              <span>{{#if this.enabled}}{{../req.t 'admin.unknownIps.providers.enabled.on'}}{{else}}{{../req.t 'admin.unknownIps.providers.enabled.off'}}{{/if}}</span>
            </label>
            <button type="submit" class="button">{{../req.t 'admin.unknownIps.providers.save'}}</button>
          </form>
        </td>
        <td>
          <form method="POST" action="/admin/unknown-ips/providers/{{this.name}}" class="provider-key-form">
            <input type="hidden" name="csrf" value="{{../csrfToken}}">
            <input type="hidden" name="enabled" value="{{#if this.enabled}}on{{else}}off{{/if}}">
            <input type="password" name="apiKey" placeholder="{{../req.t 'admin.unknownIps.providers.apiKeyPlaceholder'}}" value="{{this.apiKey}}" autocomplete="off">
            <button type="submit" class="button">{{../req.t 'admin.unknownIps.providers.save'}}</button>
          </form>
        </td>
        <td>
          {{#if this.lastUsedAt}}<span title="{{formatDate this.lastUsedAt}}">{{formatRelative this.lastUsedAt}}</span>{{else}}<span class="admin-tag admin-tag--muted">—</span>{{/if}}
          {{#if this.lastErrorReason}}
            <div class="provider-table-err">{{this.lastErrorReason}}</div>
          {{/if}}
        </td>
        <td>
          {{#if this.enabled}}<span class="admin-tag admin-tag--ok">{{../req.t 'admin.unknownIps.providers.enabled.on'}}</span>{{else}}<span class="admin-tag admin-tag--muted">{{../req.t 'admin.unknownIps.providers.enabled.off'}}</span>{{/if}}
        </td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</section>