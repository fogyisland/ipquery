{{!-- SPDX-License-Identifier: MIT --}}
{{!--
  /admin/ingest — two-tab ingest console (Strategy Execution surface):
    #overview      → runner status + queue preview + last-run aggregate
    #failure-logs  → filterable failure audit + re-queue action
  The #providers pane was moved to /admin/providers in PR1 (Strategy
  Definition surface). PR2 redirects /admin/unknown-ips/* to
  /admin/ingest/* and /admin/providers/* for back-compat.
  Tab state lives in the URL hash so reload + bookmark preserve the
  active tab.
--}}

<h2>{{@root.req.t 'admin.unknownIps.title'}}</h2>

<nav class="settings-tabs-nav" aria-label="Ingest sections">
  <a class="settings-tab-link{{#if (eq activeTab 'overview')}} is-active{{/if}}" href="#overview" data-tab="overview">{{@root.req.t 'admin.unknownIps.tabs.overview'}}</a>
  <a class="settings-tab-link{{#if (eq activeTab 'failure-logs')}} is-active{{/if}}" href="#failure-logs" data-tab="failure-logs">{{@root.req.t 'admin.unknownIps.tabs.failureLogs'}}</a>
</nav>

{{#if flash.queueFlash}}
<div class="admin-alert admin-alert--{{#if (eq flash.queueFlash.kind 'invalidIp')}}danger{{else}}info{{/if}}">
  {{#if (eq flash.queueFlash.kind 'cleared')}}
    {{@root.req.t 'admin.unknownIps.queueFlash.cleared' removed=flash.queueFlash.removed}}
  {{else if (eq flash.queueFlash.kind 'invalidIp')}}
    {{@root.req.t 'admin.unknownIps.queueFlash.invalidIp' ip=flash.queueFlash.ip}}
  {{/if}}
</div>
{{/if}}

{{!-- ════════════════════════════════════════════════════════════════════
     OVERVIEW TAB — runner control + queue preview + last-run stats
     ════════════════════════════════════════════════════════════════════ --}}
<div class="settings-tab-pane{{#if (eq activeTab 'overview')}} is-active{{/if}}" id="pane-overview" data-tab="overview">

  {{!-- Banners: backfill / generate / failure logs / queue flash --}}
  {{#if flash.backfillSummary}}
    {{#if (eq flash.backfillSummary.kind "lock_busy")}}
  <div class="admin-alert admin-alert--info">
    <strong>{{@root.req.t 'admin.unknownIps.backfill.lockBusy'}}</strong>
  </div>
    {{else}}
      {{#if (eq flash.backfillSummary.kind "preview_lock_busy")}}
  <div class="admin-alert admin-alert--info">
    <strong>{{@root.req.t 'admin.unknownIps.backfill.previewLockBusy'}}</strong>
  </div>
      {{else}}
        {{#if (eq flash.backfillSummary.kind "preview_missing")}}
  <div class="admin-alert admin-alert--info">
    <strong>{{@root.req.t 'admin.unknownIps.backfill.previewMissing'}}</strong>
  </div>
        {{else}}
          {{#if (eq flash.backfillSummary.kind "preview_expired")}}
  <div class="admin-alert admin-alert--info">
    <strong>{{@root.req.t 'admin.unknownIps.backfill.previewExpired'}}</strong>
  </div>
          {{else}}
  <div class="admin-alert admin-alert--success">
    <strong>{{@root.req.t 'admin.unknownIps.backfill.summary'}}</strong>
    <ul class="admin-summary-list">
      <li>{{@root.req.t 'admin.unknownIps.backfill.considered'}}: {{flash.backfillSummary.considered}}</li>
      <li>{{@root.req.t 'admin.unknownIps.backfill.merged'}}: {{flash.backfillSummary.merged}}</li>
      <li>{{@root.req.t 'admin.unknownIps.backfill.noConsensus'}}: {{flash.backfillSummary.noConsensus}}</li>
      <li>{{@root.req.t 'admin.unknownIps.backfill.noCountry'}}: {{flash.backfillSummary.noCountry}}</li>
      <li>{{@root.req.t 'admin.unknownIps.backfill.allAbstained'}}: {{flash.backfillSummary.allAbstained}}</li>
    </ul>
  </div>
          {{/if}}
        {{/if}}
      {{/if}}
    {{/if}}
  {{/if}}

  {{#if flash.generateSummary}}
    {{#if (eq flash.generateSummary.kind "lock_busy")}}
  <div class="admin-alert admin-alert--info">
    <strong>{{@root.req.t 'admin.unknownIps.generate.lockBusy'}}</strong>
  </div>
    {{else}}
  <div class="admin-alert admin-alert--info">
    <strong>{{@root.req.t 'admin.unknownIps.generate.summary'}}</strong>
    <ul class="admin-summary-list">
      <li>{{@root.req.t 'admin.unknownIps.generate.considered'}}: {{flash.generateSummary.considered}}</li>
      <li>{{@root.req.t 'admin.unknownIps.generate.merged'}}: {{flash.generateSummary.merged}}</li>
      <li>{{@root.req.t 'admin.unknownIps.generate.noConsensus'}}: {{flash.generateSummary.noConsensus}}</li>
      <li>{{@root.req.t 'admin.unknownIps.generate.noCountry'}}: {{flash.generateSummary.noCountry}}</li>
      <li>{{@root.req.t 'admin.unknownIps.generate.allAbstained'}}: {{flash.generateSummary.allAbstained}}</li>
      <li>{{@root.req.t 'admin.unknownIps.generate.exhaustedRetries'}}: {{flash.generateSummary.exhaustedRetries}}</li>
      {{#if flash.generateSummary.providersDisabled.length}}
      <li class="admin-summary-disabled">
        {{@root.req.t 'admin.unknownIps.generate.providersDisabled'}}: {{flash.generateSummary.providersDisabled}}
      </li>
      {{/if}}
      {{#if flash.generateSummary.generatedIps.length}}
      <li class="admin-summary-ips">
        <details>
          <summary>{{@root.req.t 'admin.unknownIps.generate.ipList'}}</summary>
          <code class="admin-ips">{{flash.generateSummary.generatedIps}}</code>
        </details>
      </li>
      {{/if}}
    </ul>
  </div>
    {{/if}}
  {{/if}}

  {{!-- Runner Status card. Combines the 3 stats + backfill/generate
       actions + queue bulk ops in one tight row. --}}
  <div class="runner-card">
    <div class="runner-card-head">
      <h3>{{@root.req.t 'admin.unknownIps.runner.title'}}</h3>
    </div>
    <div class="runner-card-body">
      <div class="runner-stat">
        <span class="runner-stat-value">{{stats.pending}}</span>
        <span class="runner-stat-label">{{@root.req.t 'admin.unknownIps.runner.queueBacklog'}}</span>
      </div>
      <div class="runner-stat">
        <span class="runner-stat-value">
          {{#if lastBackfillRunAt}}{{formatRelative req lastBackfillRunAt}}{{else}}<span class="admin-tag admin-tag--muted">{{@root.req.t 'admin.unknownIps.runner.noLastRun'}}</span>{{/if}}
        </span>
        <span class="runner-stat-label">{{@root.req.t 'admin.unknownIps.runner.lastRun'}}</span>
      </div>
      <div class="runner-stat">
        <span class="runner-stat-value">{{stats.processed}}</span>
        <span class="runner-stat-label">{{@root.req.t 'admin.unknownIps.stats.processed'}}</span>
      </div>
      <div class="runner-stat">
        <span class="runner-stat-value">{{stats.totalQueries}}</span>
        <span class="runner-stat-label">{{@root.req.t 'admin.unknownIps.stats.totalQueries'}}</span>
      </div>
    </div>
    <div class="runner-card-actions">
      <form method="GET" action="/admin/ingest/backfill/confirm" class="inline-form">
        <button type="submit" class="btn-primary">{{@root.req.t 'admin.unknownIps.runner.backfillNow'}}</button>
      </form>
      <form method="POST" action="/admin/ingest/generate" class="inline-form"
            data-confirm="{{@root.req.t 'admin.unknownIps.generate.confirm'}}">
        <input type="hidden" name="csrf" value="{{csrfToken}}">
        <input type="hidden" name="count" value="10">
        <button type="submit" class="btn-secondary">{{@root.req.t 'admin.unknownIps.runner.generateNow'}}</button>
      </form>
    </div>
    <div class="runner-card-queue">
      <span class="runner-card-queue-label">{{@root.req.t 'admin.unknownIps.runner.queueActions'}}</span>
      <form method="POST" action="/admin/ingest/queue/clear" class="inline-form"
            data-confirm="确定清空所有待回灌 IP?已入库的 IP 不会被删除。">
        <input type="hidden" name="csrf" value="{{csrfToken}}">
        <button type="submit" class="btn-secondary" {{#unless stats.pending}}disabled{{/unless}}>{{@root.req.t 'admin.unknownIps.runner.clearQueue'}}</button>
      </form>
      <a class="btn-secondary" href="/admin/ingest/queue/export">{{@root.req.t 'admin.unknownIps.runner.exportQueue'}}</a>
    </div>
  </div>

  {{!-- Continuous random-IP ingest — scheduler card. Combines status,
       configurable schedule, cooldown banner, and metrics into one card. --}}
  {{#if randomGenState}}
  {{#if randomGenConfig}}
  <div class="scheduler-card">
    <div class="scheduler-card-head">
      <div>
        <h3>{{@root.req.t 'admin.unknownIps.scheduler.title'}}</h3>
        <p class="scheduler-card-sub">{{@root.req.t 'admin.unknownIps.scheduler.subtitle' interval=randomGenConfig.intervalSec batch=randomGenConfig.batchSize}}</p>
      </div>
      <span class="scheduler-status-pill scheduler-status-pill--{{#if randomGenState.cooldownRemainingMin}}cooldown{{else if randomGenState.enabled}}running{{else}}stopped{{/if}}">
        {{#if randomGenState.cooldownRemainingMin}}
          {{@root.req.t 'admin.unknownIps.scheduler.status.cooldown'}}
        {{else if randomGenState.enabled}}
          {{@root.req.t 'admin.unknownIps.scheduler.status.running'}}
        {{else}}
          {{@root.req.t 'admin.unknownIps.scheduler.status.stopped'}}
        {{/if}}
      </span>
    </div>

    {{!-- Cooldown banner — only when a previous tick disabled a provider
         and the cooldown window is still active. Helps operators see why
         the runner is silent without having to inspect the settings table. --}}
    {{#if randomGenState.cooldownRemainingMin}}
    <div class="scheduler-cooldown-banner">
      <strong>⏸ {{@root.req.t 'admin.unknownIps.scheduler.cooldownNotice' provider=randomGenState.lastSkipReason remaining=randomGenState.cooldownRemainingMin}}</strong>
    </div>
    {{/if}}

    {{!-- Config form — interval / batch / target range / CB linkage.
         Saved via POST /admin/ingest/scheduler which clamps to safe
         ranges and calls syncFromSettings to restart the timer. --}}
    <form method="POST" action="/admin/ingest/scheduler" class="scheduler-card-form">
      <input type="hidden" name="csrf" value="{{csrfToken}}">
      <div class="scheduler-card-grid">
        <label>
          <span>{{@root.req.t 'admin.unknownIps.scheduler.config.interval'}}</span>
          <select name="intervalSec">
            <option value="30" {{#if (eq randomGenConfig.intervalSec 30)}}selected{{/if}}>{{@root.req.t 'admin.unknownIps.scheduler.intervalOptions.30s'}}</option>
            <option value="60" {{#if (eq randomGenConfig.intervalSec 60)}}selected{{/if}}>{{@root.req.t 'admin.unknownIps.scheduler.intervalOptions.1m'}}</option>
            <option value="300" {{#if (eq randomGenConfig.intervalSec 300)}}selected{{/if}}>{{@root.req.t 'admin.unknownIps.scheduler.intervalOptions.5m'}}</option>
            <option value="900" {{#if (eq randomGenConfig.intervalSec 900)}}selected{{/if}}>{{@root.req.t 'admin.unknownIps.scheduler.intervalOptions.15m'}}</option>
            <option value="1800" {{#if (eq randomGenConfig.intervalSec 1800)}}selected{{/if}}>{{@root.req.t 'admin.unknownIps.scheduler.intervalOptions.30m'}}</option>
          </select>
        </label>
        <label>
          <span>{{@root.req.t 'admin.unknownIps.scheduler.config.batchSize'}}</span>
          <input type="number" name="batchSize" min="1" max="100" value="{{randomGenConfig.batchSize}}">
        </label>
        <label>
          <span>{{@root.req.t 'admin.unknownIps.scheduler.config.targetRange'}}</span>
          <select name="targetRange" disabled>
            <option value="reserved" selected>{{@root.req.t 'admin.unknownIps.scheduler.targetRangeOptions.reserved'}}</option>
          </select>
        </label>
        <label>
          <span>{{@root.req.t 'admin.unknownIps.scheduler.config.cooldown'}}</span>
          <input type="number" name="cooldownMinutes" min="0" max="1440" value="{{randomGenConfig.cooldownMinutes}}">
        </label>
        <label>
          <span>{{@root.req.t 'admin.unknownIps.scheduler.config.retentionDays'}}</span>
          <input type="number" name="retentionDays" min="0" max="3650" value="{{retentionDays}}">
          <span class="form-field-hint">{{@root.req.t 'admin.unknownIps.scheduler.config.retentionDaysHint'}}</span>
        </label>
        <label class="scheduler-toggle">
          <input type="checkbox" name="cbLinkage" value="on" {{#if randomGenConfig.cbLinkage}}checked{{/if}}>
          <span>{{@root.req.t 'admin.unknownIps.scheduler.config.cbLinkage'}}</span>
        </label>
      </div>
      <div class="scheduler-card-actions">
        <button type="submit" class="btn-primary">{{@root.req.t 'admin.unknownIps.scheduler.config.save'}}</button>
        <button type="submit" form="scheduler-kick-form" class="btn-secondary" {{#unless randomGenState.enabled}}disabled{{/unless}}>{{@root.req.t 'admin.unknownIps.scheduler.runNow'}}</button>
      </div>
    </form>
    {{!-- Kick form lives outside the config form so its submit doesn't
         accidentally POST the scheduler form fields. The disabled
         attribute mirrors the config form's button via the JS below. --}}
    <form id="scheduler-kick-form" method="POST" action="/admin/ingest/generate/continuous" class="inline-form"
          data-confirm="{{@root.req.t 'admin.unknownIps.scheduler.runNowConfirm'}}">
      <input type="hidden" name="csrf" value="{{csrfToken}}">
      <input type="hidden" name="kick" value="1">
    </form>

    {{!-- Continuous toggle + metrics row --}}
    <div class="scheduler-card-stats">
      <form method="POST" action="/admin/ingest/generate/continuous" class="inline-form">
        <input type="hidden" name="csrf" value="{{csrfToken}}">
        <input type="hidden" name="enabled" value="{{#if randomGenState.enabled}}off{{else}}on{{/if}}">
        <button type="submit" class="btn-{{#if randomGenState.enabled}}secondary{{else}}primary{{/if}}">
          {{#if randomGenState.enabled}}{{@root.req.t 'admin.unknownIps.scheduler.wizard.disabled'}}{{else}}{{@root.req.t 'admin.unknownIps.scheduler.wizard.enabled'}}{{/if}}
        </button>
      </form>
      <div class="scheduler-stat">
        <span class="scheduler-stat-label">{{@root.req.t 'admin.unknownIps.scheduler.metrics.lastRun'}}</span>
        <span class="scheduler-stat-value">
          {{#if randomGenState.lastRunAt}}<span title="{{randomGenState.lastRunAt}}">{{formatRelative req randomGenState.lastRunAt}}</span>
          {{else}}<span class="admin-tag admin-tag--muted">{{@root.req.t 'admin.unknownIps.scheduler.metrics.noLastRun'}}</span>{{/if}}
        </span>
      </div>
      <div class="scheduler-stat">
        <span class="scheduler-stat-label">{{@root.req.t 'admin.unknownIps.scheduler.metrics.lastYield'}}</span>
        <span class="scheduler-stat-value">
          {{#if randomGenState.lastSummary}}{{randomGenState.lastSummary.merged}}/{{randomGenState.lastSummary.considered}}{{else}}—{{/if}}
        </span>
      </div>
      <div class="scheduler-stat">
        <span class="scheduler-stat-label">{{@root.req.t 'admin.unknownIps.scheduler.metrics.warmingRate'}}</span>
        <span class="scheduler-stat-value">
          {{#if probeSummaryStats}}{{probeSummaryStats.warmingRatePerDay}}{{else}}0{{/if}}
          <span class="scheduler-stat-unit">/d</span>
        </span>
      </div>
      <div class="scheduler-stat">
        <span class="scheduler-stat-label">{{@root.req.t 'admin.unknownIps.scheduler.metrics.probeSuccessRate'}}</span>
        <span class="scheduler-stat-value">
          {{#if probeSummaryStats}}{{probeSummaryStats.successRatePct}}{{else}}0{{/if}}<span class="scheduler-stat-unit">%</span>
        </span>
      </div>
    </div>
  </div>
  {{/if}}
  {{/if}}

  {{!-- Recent probes — per-IP audit trail across all 3 ingest flows.
       Each row expands to show the per-provider fan-out detail so the
       operator can see why consensus failed or succeeded. --}}
  <h3 class="probe-log-heading">{{@root.req.t 'admin.unknownIps.recentProbes.title'}}</h3>
  <p class="probe-log-help">{{@root.req.t 'admin.unknownIps.recentProbes.help'}}</p>

  {{!-- Mode filter — narrows the recent table to a single ingest flow.
       URL-driven so it survives reload + bookmark; default is "all". --}}
  <form method="GET" action="/admin/ingest" class="probe-log-filters">
    <input type="hidden" name="tab" value="overview">
    <label>
      <span>{{@root.req.t 'admin.unknownIps.failureLogs.filterMode'}}</span>
      <select name="mode">
        <option value="">{{@root.req.t 'admin.unknownIps.failureLogs.allModes'}}</option>
        <option value="auto" {{#if (eq errorFilters.mode 'auto')}}selected{{/if}}>{{@root.req.t 'admin.unknownIps.failureLogs.modeLabel.auto'}}</option>
        <option value="manual" {{#if (eq errorFilters.mode 'manual')}}selected{{/if}}>{{@root.req.t 'admin.unknownIps.failureLogs.modeLabel.manual'}}</option>
        <option value="random" {{#if (eq errorFilters.mode 'random')}}selected{{/if}}>{{@root.req.t 'admin.unknownIps.failureLogs.modeLabel.random'}}</option>
      </select>
    </label>
    <button type="submit" class="btn-secondary">{{@root.req.t 'admin.unknownIps.failureLogs.applyFilters'}}</button>
  </form>

  {{#if recentProbes.length}}
  <table class="probe-log-table">
    <thead>
      <tr>
        <th>{{@root.req.t 'admin.unknownIps.recentProbes.cols.ts'}}</th>
        <th>{{@root.req.t 'admin.unknownIps.recentProbes.cols.ip'}}</th>
        <th>{{@root.req.t 'admin.unknownIps.recentProbes.cols.providers'}}</th>
        <th>{{@root.req.t 'admin.unknownIps.recentProbes.cols.consensus'}}</th>
        <th>{{@root.req.t 'admin.unknownIps.recentProbes.cols.outcome'}}</th>
      </tr>
    </thead>
    <tbody>
      {{#each recentProbes}}
      <tr class="probe-log-row">
        <td title="{{formatDate this.ts}}">{{formatRelative @root.req this.ts}}</td>
        <td><code>{{this.ipText}}</code></td>
        <td>
          <div class="probe-log-cells">
            {{#each this.providers}}
            {{!-- Classify each provider cell into one of 7 visual states.
                 Priority: rateLimited > error > timeout > no_country >
                 ok > empty. The ok state shows the country code so
                 operators can spot disagreement at a glance. --}}
            <span class="provider-cell
              {{#if this.rateLimited}}provider-cell--throttled
              {{else if this.errorCode}}provider-cell--error
              {{else if this.countryCode}}provider-cell--ok
              {{else}}provider-cell--no_country{{/if}}">
              {{this.provider}}{{#if this.countryCode}} {{this.countryCode}}{{/if}}
            </span>
            {{/each}}
          </div>
          <details class="probe-log-detail">
            <summary>{{@root.req.t 'admin.unknownIps.recentProbes.detailToggle'}}</summary>
            <table class="probe-detail-table">
              <thead>
                <tr>
                  <th>{{@root.req.t 'admin.unknownIps.recentProbes.detailCols.provider'}}</th>
                  <th>{{@root.req.t 'admin.unknownIps.recentProbes.detailCols.status'}}</th>
                  <th>{{@root.req.t 'admin.unknownIps.recentProbes.detailCols.country'}}</th>
                  <th>{{@root.req.t 'admin.unknownIps.recentProbes.detailCols.city'}}</th>
                  <th>{{@root.req.t 'admin.unknownIps.recentProbes.detailCols.asn'}}</th>
                  <th>{{@root.req.t 'admin.unknownIps.recentProbes.detailCols.duration'}}</th>
                  <th>{{@root.req.t 'admin.unknownIps.recentProbes.detailCols.errorCode'}}</th>
                </tr>
              </thead>
              <tbody>
                {{#each this.providers}}
                <tr>
                  <td><code>{{this.provider}}</code></td>
                  <td>
                    {{#if this.rateLimited}}{{@root.req.t 'admin.unknownIps.recentProbes.providerCell.throttled'}}
                    {{else if (eq this.errorCode 'timeout')}}{{@root.req.t 'admin.unknownIps.recentProbes.providerCell.timeout'}}
                    {{else if (eq this.errorCode 'network')}}{{@root.req.t 'admin.unknownIps.recentProbes.providerCell.network'}}
                    {{else if this.errorCode}}{{@root.req.t 'admin.unknownIps.recentProbes.providerCell.error'}} ({{this.errorCode}})
                    {{else if this.countryCode}}{{@root.req.t 'admin.unknownIps.recentProbes.providerCell.ok'}}
                    {{else}}{{@root.req.t 'admin.unknownIps.recentProbes.providerCell.no_country'}}{{/if}}
                  </td>
                  <td>{{#if this.countryCode}}{{this.countryCode}}{{else}}—{{/if}}</td>
                  <td>{{#if this.city}}{{this.city}}{{else}}—{{/if}}</td>
                  <td>{{#if this.asn}}{{this.asn}}{{else}}—{{/if}}</td>
                  <td>{{this.durationMs}}ms</td>
                  <td>{{#if this.errorCode}}<span class="admin-tag admin-tag--warn">{{this.errorCode}}</span>{{else}}—{{/if}}</td>
                </tr>
                {{/each}}
              </tbody>
            </table>
            {{#if this.batchId}}<p class="probe-detail-batch">{{@root.req.t 'admin.unknownIps.recentProbes.batchIdLabel'}}: <code>{{this.batchId}}</code></p>{{/if}}
          </details>
        </td>
        <td>
          {{#if this.consensusCountry}}<span class="admin-tag admin-tag--ok">{{this.consensusCountry}}{{#if this.consensusCity}} · {{this.consensusCity}}{{/if}}</span>
          {{else}}<span class="admin-tag admin-tag--muted">—</span>{{/if}}
        </td>
        <td>
          {{#if (eq this.outcome 'merged')}}<span class="admin-tag admin-tag--ok">{{@root.req.t 'admin.unknownIps.recentProbes.outcomeLabel.merged'}}</span>
          {{else if (eq this.outcome 'no_consensus')}}<span class="admin-tag admin-tag--warn">{{@root.req.t 'admin.unknownIps.recentProbes.outcomeLabel.no_consensus'}}</span>
          {{else if (eq this.outcome 'no_country')}}<span class="admin-tag admin-tag--warn">{{@root.req.t 'admin.unknownIps.recentProbes.outcomeLabel.no_country'}}</span>
          {{else}}<span class="admin-tag admin-tag--muted">{{@root.req.t 'admin.unknownIps.recentProbes.outcomeLabel.all_abstained'}}</span>{{/if}}
        </td>
      </tr>
      {{/each}}
    </tbody>
  </table>
  {{else}}
  <p class="admin-empty">{{@root.req.t 'admin.unknownIps.recentProbes.noProbes'}}</p>
  {{/if}}

  {{!-- Queue preview tables --}}
  <h3>{{@root.req.t 'admin.unknownIps.section.pending'}}</h3>
  {{#if pending.length}}
  <table class="admin-table">
    <thead>
      <tr>
        <th>{{@root.req.t 'admin.unknownIps.col.ip'}}</th>
        <th>{{@root.req.t 'admin.unknownIps.col.queryCount'}}</th>
        <th>{{@root.req.t 'admin.unknownIps.col.firstSeen'}}</th>
        <th>{{@root.req.t 'admin.unknownIps.col.lastSeen'}}</th>
        <th>{{@root.req.t 'admin.unknownIps.col.source'}}</th>
        <th>{{@root.req.t 'admin.unknownIps.col.lastAttempt'}}</th>
      </tr>
    </thead>
    <tbody>
      {{#each pending}}
      <tr>
        <td><code>{{this.ipText}}</code></td>
        <td>{{this.queryCount}}</td>
        <td>{{formatDate this.firstSeenAt}}</td>
        <td>{{formatDate this.lastSeenAt}}</td>
        <td><span class="admin-tag admin-tag--{{this.source}}">{{this.source}}</span></td>
        <td>
          {{#if this.lastAttemptReason}}
            <span class="admin-tag admin-tag--warn">{{this.lastAttemptReason}}</span>
          {{else}}
            —
          {{/if}}
        </td>
      </tr>
      {{/each}}
    </tbody>
  </table>
  {{else}}
  <p class="admin-empty">{{@root.req.t 'admin.unknownIps.empty.pending'}}</p>
  {{/if}}

  {{#if recentlyProcessed.length}}
  <h3>{{@root.req.t 'admin.unknownIps.section.recentlyProcessed'}}</h3>
  <table class="admin-table">
    <thead>
      <tr>
        <th>{{@root.req.t 'admin.unknownIps.col.ip'}}</th>
        <th>{{@root.req.t 'admin.unknownIps.col.queryCount'}}</th>
        <th>{{@root.req.t 'admin.unknownIps.col.processedAt'}}</th>
        <th>{{@root.req.t 'admin.unknownIps.col.runId'}}</th>
      </tr>
    </thead>
    <tbody>
      {{#each recentlyProcessed}}
      <tr>
        <td><code>{{this.ipText}}</code></td>
        <td>{{this.queryCount}}</td>
        <td>{{formatDate this.processedAt}}</td>
        <td>{{#if this.mergedRunId}}{{this.mergedRunId}}{{else}}<span class="admin-tag admin-tag--muted">{{@root.req.t 'admin.unknownIps.runId.manual'}}</span>{{/if}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>
  {{/if}}
</div>

{{!-- ════════════════════════════════════════════════════════════════════
     FAILURE LOGS TAB — filterable audit + re-queue action
     ════════════════════════════════════════════════════════════════════ --}}
<div class="settings-tab-pane{{#if (eq activeTab 'failure-logs')}} is-active{{/if}}" id="pane-failure-logs" data-tab="failure-logs">

  <h3>{{@root.req.t 'admin.unknownIps.failureLogs.title'}}</h3>
  <p class="failure-logs-help">{{@root.req.t 'admin.unknownIps.failureLogs.help'}}</p>

  <form method="GET" action="/admin/ingest" class="failure-logs-filters">
    <input type="hidden" name="tab" value="failure-logs">
    <label>
      <span>{{@root.req.t 'admin.unknownIps.failureLogs.filterProvider'}}</span>
      <select name="provider">
        <option value="">{{@root.req.t 'admin.unknownIps.failureLogs.allProviders'}}</option>
        {{#each providers}}
        <option value="{{this.name}}" {{#if (eq ../errorFilters.provider this.name)}}selected{{/if}}>{{this.displayName}}</option>
        {{/each}}
      </select>
    </label>
    <label>
      <span>{{@root.req.t 'admin.unknownIps.failureLogs.filterCode'}}</span>
      <select name="errorCode">
        <option value="">{{@root.req.t 'admin.unknownIps.failureLogs.allCodes'}}</option>
        {{#each errorCodes}}
        <option value="{{this}}" {{#if (eq ../errorFilters.errorCode this)}}selected{{/if}}>{{this}}</option>
        {{/each}}
      </select>
    </label>
    <label>
      <span>{{@root.req.t 'admin.unknownIps.failureLogs.filterMode'}}</span>
      <select name="mode">
        <option value="">{{@root.req.t 'admin.unknownIps.failureLogs.allModes'}}</option>
        <option value="auto" {{#if (eq errorFilters.mode 'auto')}}selected{{/if}}>{{@root.req.t 'admin.unknownIps.failureLogs.modeLabel.auto'}}</option>
        <option value="manual" {{#if (eq errorFilters.mode 'manual')}}selected{{/if}}>{{@root.req.t 'admin.unknownIps.failureLogs.modeLabel.manual'}}</option>
        <option value="random" {{#if (eq errorFilters.mode 'random')}}selected{{/if}}>{{@root.req.t 'admin.unknownIps.failureLogs.modeLabel.random'}}</option>
      </select>
    </label>
    <label>
      <span>{{@root.req.t 'admin.unknownIps.failureLogs.filterSince'}}</span>
      <select name="since">
        <option value="">—</option>
        <option value="1h" {{#if (eq errorFilters.since '1h')}}selected{{/if}}>{{@root.req.t 'admin.unknownIps.failureLogs.since1h'}}</option>
        <option value="24h" {{#if (eq errorFilters.since '24h')}}selected{{/if}}>{{@root.req.t 'admin.unknownIps.failureLogs.since24h'}}</option>
        <option value="7d" {{#if (eq errorFilters.since '7d')}}selected{{/if}}>{{@root.req.t 'admin.unknownIps.failureLogs.since7d'}}</option>
      </select>
    </label>
    <button type="submit" class="btn-secondary">应用</button>
  </form>

  {{#if errors.length}}
  <table class="admin-table">
    <thead>
      <tr>
        <th>{{@root.req.t 'admin.unknownIps.failureLogs.col.ts'}}</th>
        <th>{{@root.req.t 'admin.unknownIps.failureLogs.col.provider'}}</th>
        <th>{{@root.req.t 'admin.unknownIps.failureLogs.col.ip'}}</th>
        <th>{{@root.req.t 'admin.unknownIps.failureLogs.col.mode'}}</th>
        <th>{{@root.req.t 'admin.unknownIps.failureLogs.col.code'}}</th>
        <th>{{@root.req.t 'admin.unknownIps.failureLogs.col.reason'}}</th>
        <th>{{@root.req.t 'admin.unknownIps.failureLogs.col.actions'}}</th>
      </tr>
    </thead>
    <tbody>
      {{#each errors}}
      <tr>
        <td title="{{formatDate this.ts}}">{{formatRelative @root.req this.ts}}</td>
        <td><code>{{this.providerName}}</code></td>
        <td><code>{{this.ipText}}</code></td>
        <td>{{#if (eq this.mode 'auto')}}{{@root.req.t 'admin.unknownIps.failureLogs.modeLabel.auto'}}{{else if (eq this.mode 'manual')}}{{@root.req.t 'admin.unknownIps.failureLogs.modeLabel.manual'}}{{else if (eq this.mode 'random')}}{{@root.req.t 'admin.unknownIps.failureLogs.modeLabel.random'}}{{else}}{{this.mode}}{{/if}}</td>
        <td><span class="admin-tag admin-tag--warn">{{this.errorCode}}</span></td>
        <td class="failure-log-reason" title="{{this.rawResponse}}">{{this.reason}}</td>
        <td>
          <form method="POST" action="/admin/ingest/failure-logs/requeue" class="inline-form">
            <input type="hidden" name="csrf" value="{{../../csrfToken}}">
            <input type="hidden" name="ip" value="{{this.ipText}}">
            <button type="submit" class="button">{{@root.req.t 'admin.unknownIps.failureLogs.requeue'}}</button>
          </form>
        </td>
      </tr>
      {{/each}}
    </tbody>
  </table>
  {{else}}
  <p class="admin-empty">{{@root.req.t 'admin.unknownIps.failureLogs.empty'}}</p>
  {{/if}}
</div>

