<h1>{{req.t 'admin.unknownIps.backfill.confirm.title'}}</h1>
<p>{{req.t 'admin.unknownIps.backfill.confirm.body'}}</p>
<form method="POST" action="/admin/unknown-ips/backfill">
  <input type="hidden" name="csrf" value="{{req.csrfToken}}">
  <label>
    {{req.t 'admin.unknownIps.backfill.batchLimit'}}
    <input type="number" name="batchLimit" value="100" min="1" max="1000">
  </label>
  <button type="submit" class="btn-primary">{{req.t 'admin.unknownIps.backfill.run'}}</button>
  <a href="/admin/unknown-ips">{{req.t 'common.cancel'}}</a>
</form>