<h1>{{req.t "admin.users.delete.confirm.title"}}</h1>
<p>{{req.t "admin.users.delete.confirm.body" email=user.email}}</p>
<form method="POST" action="/admin/users/{{user.id}}/delete">
  <input type="hidden" name="csrf" value="{{req.csrfToken}}" />
  <button type="submit" class="btn-danger">{{req.t "admin.users.action.delete"}}</button>
  <a href="/admin/users/{{user.id}}">{{req.t "common.cancel"}}</a>
</form>