<section hx-get="/admin/queries" hx-trigger="every 30s" hx-swap="outerHTML" hx-select="section">
<h2>{{req.t 'admin.queries.title'}}</h2>

<form method="GET" action="/admin/queries" class="filter-bar">
  <label class="filter-label">{{req.t 'admin.queries.since'}}
    <input type="date" name="since" class="filter-select" value="{{filters.since}}">
  </label>
  <label class="filter-label">{{req.t 'admin.queries.until'}}
    <input type="date" name="until" class="filter-select" value="{{filters.until}}">
  </label>
  <button type="submit" class="button">{{req.t 'common.filter'}}</button>
  <a class="button button-secondary" href="/admin/queries.csv?{{#if filters.since}}since={{filters.since}}&{{/if}}{{#if filters.until}}until={{filters.until}}{{/if}}">{{req.t 'common.exportCsv'}}</a>
</form>

<div class="dashboard-grid">
  <div class="card">
    <p class="card-title">{{@root.req.t 'admin.queries.total'}}</p>
    <p class="card-value">{{stats.total}}</p>
    <p class="card-sub">{{@root.req.t 'admin.queries.hitRate'}} {{percent hitRate 0}}</p>
    {{> sparkline data=stats.hourly max=(max stats.hourly 1) }}
  </div>
</div>

<div class="dashboard-grid">
  <div class="card">
    <h3 class="card-title">{{@root.req.t 'admin.queries.topIps'}}</h3>
    <table class="table">
      <thead><tr><th>IP</th><th class="table-num">n</th></tr></thead>
      <tbody>
        {{#each stats.topIps}}
        <tr>
          <td><code>{{this.ip_text}}</code></td>
          <td class="table-num">{{this.n}}</td>
        </tr>
        {{else}}
        <tr><td colspan="2">&mdash;</td></tr>
        {{/each}}
      </tbody>
    </table>
  </div>

  <div class="card">
    <h3 class="card-title">{{@root.req.t 'admin.queries.topUsers'}}</h3>
    <table class="table">
      <thead><tr><th>User</th><th class="table-num">n</th></tr></thead>
      <tbody>
        {{#each stats.topUsers}}
        <tr>
          <td>{{this.user_email}}</td>
          <td class="table-num">{{this.n}}</td>
        </tr>
        {{else}}
        <tr><td colspan="2">&mdash;</td></tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>
</section>
