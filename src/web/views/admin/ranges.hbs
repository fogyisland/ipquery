{{!--
  /admin/ranges — move IP ranges in and out as a .ipq file.

  One page for both directions, because they are the same file: an operator
  exports from one install and imports on another, and the page should read
  as one idea rather than two unrelated tools.

  Both directions run in the background. A whole-library file is around two
  gigabytes and takes long enough that a request held open for it is a
  request a proxy kills -- so the request answers as soon as the job is
  accepted, and the list below is where the operator watches it.

  The export list is a table, not per-process state. A restart used to
  clear it while the files stayed on disk, so a link the operator already
  had stopped working.
--}}
<h2>{{req.t 'admin.ranges.title'}}</h2>
<p class="admin-section-help">{{req.t 'admin.ranges.help'}}</p>

<div class="range-grid">
  {{!-- ── Export ─────────────────────────────────────────────────── --}}
  <section class="range-card" id="range-export">
    <h3>{{req.t 'admin.ranges.export.title'}}</h3>
    <p class="admin-section-help">{{req.t 'admin.ranges.export.help'}}</p>
    <form method="post" action="/admin/ranges/export" data-confirm="{{req.t 'admin.ranges.export.confirm'}}">
      <input type="hidden" name="csrf" value="{{csrfToken}}">
      <div class="form-field">
        <label class="form-field-label" for="export-country">{{req.t 'admin.ranges.export.country'}}</label>
        <div class="form-field-input">
          <input id="export-country" type="text" name="country" maxlength="2" placeholder="{{req.t 'admin.ranges.export.countryPlaceholder'}}" autocomplete="off">
          <span class="form-field-hint">{{req.t 'admin.ranges.export.countryHint'}}</span>
        </div>
      </div>
      <button type="submit" class="btn-primary">{{req.t 'admin.ranges.export.action'}}</button>
    </form>

    {{#if lastExport}}
    {{!-- Named right above the button that produced it: the operator who just
         clicked does not have to find the row in the table below. Only a
         finished export has a file to offer, so a running one waits. --}}
    {{#unless lastExport.isRunning}}
    <p class="range-latest">
      <a class="btn-secondary" href="{{downloadUrl}}">{{req.t 'admin.ranges.export.list.downloadLatest'}}</a>
      <span class="form-field-hint">{{lastExport.rows}} {{req.t 'admin.ranges.export.list.rowsUnit'}} · {{lastExport.sizeLabel}}</span>
    </p>
    {{/unless}}
    {{/if}}

    {{#if exports.length}}
    <table class="range-export-table">
      <thead>
        <tr>
          <th>{{req.t 'admin.ranges.export.list.file'}}</th>
          <th>{{req.t 'admin.ranges.export.list.rows'}}</th>
          <th>{{req.t 'admin.ranges.export.list.size'}}</th>
          <th>{{req.t 'admin.ranges.export.list.created'}}</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {{#each exports}}
        <tr>
          <td><code>{{this.id}}.ipq</code></td>
          <td>{{this.rows}}</td>
          <td>{{this.sizeLabel}}</td>
          <td><time datetime="{{this.createdAtLabel}}">{{this.createdAtLabel}}</time></td>
          <td>
            {{#if this.isRunning}}
            <span class="pill pill-info">{{@root.req.t 'admin.ranges.jobs.running'}}</span>
            {{else if this.errorMessage}}
            <span class="pill pill-danger">{{@root.req.t 'admin.ranges.export.list.failed'}}</span>
            {{else}}
            <a class="btn-secondary" href="/admin/ranges/download/{{this.id}}">{{@root.req.t 'admin.ranges.export.list.download'}}</a>
            {{/if}}
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
    {{else}}
    <p class="form-field-hint">{{req.t 'admin.ranges.export.list.empty'}}</p>
    {{/if}}
  </section>

  {{!-- ── Import ─────────────────────────────────────────────────── --}}
  <section class="range-card" id="range-import">
    <h3>{{req.t 'admin.ranges.import.title'}}</h3>
    <p class="admin-section-help">{{req.t 'admin.ranges.import.help'}}</p>
    <form method="post" action="/admin/ranges/import" enctype="multipart/form-data">
      <input type="hidden" name="csrf" value="{{csrfToken}}">
      <div class="form-field">
        <label class="form-field-label" for="import-file">{{req.t 'admin.ranges.import.file'}}</label>
        <div class="form-field-input">
          <input id="import-file" type="file" name="file" accept=".ipq,application/x-ndjson,text/plain" required>
          <span class="form-field-hint">{{req.t 'admin.ranges.import.fileHint' ceiling=ceilingLabel limit=limitLabel}}</span>
        </div>
      </div>
      <button type="submit" class="btn-primary">{{req.t 'admin.ranges.import.action'}}</button>
    </form>

    {{!-- Replacement is a different decision from merging, so it is a
         different form with its own warning — not a checkbox tucked next to
         the safe one. The confirmation is the current row count: the
         operator has to look at the number and type it, which is what stops
         a browser "resend" from wiping the library. --}}
    <details class="range-replace">
      <summary>{{req.t 'admin.ranges.replace.title'}}</summary>
      <p class="range-replace-warning">{{req.t 'admin.ranges.replace.warning'}}</p>
      <p class="form-field-hint">{{req.t 'admin.ranges.replace.currentRows'}} <strong>{{currentRows}}</strong></p>
      <form method="post" action="/admin/ranges/import" enctype="multipart/form-data">
        <input type="hidden" name="csrf" value="{{csrfToken}}">
        <input type="hidden" name="mode" value="replace">
        <div class="form-field">
          <label class="form-field-label" for="replace-file">{{req.t 'admin.ranges.import.file'}}</label>
          <div class="form-field-input">
            <input id="replace-file" type="file" name="file" accept=".ipq,application/x-ndjson,text/plain" required>
          </div>
        </div>
        <div class="form-field">
          <label class="form-field-label" for="replace-confirm">{{req.t 'admin.ranges.replace.confirmLabel'}}</label>
          <div class="form-field-input">
            <input id="replace-confirm" type="number" name="confirmRows" min="0" required
                   inputmode="numeric" placeholder="{{currentRows}}">
            <span class="form-field-hint">{{req.t 'admin.ranges.replace.confirmHint'}}</span>
          </div>
        </div>
        <button type="submit" class="btn-danger">{{req.t 'admin.ranges.replace.action'}}</button>
      </form>
    </details>
    <p class="form-field-hint">{{req.t 'admin.ranges.import.ceilingPre'}} {{maxRows}} {{req.t 'admin.ranges.import.ceilingPost'}}</p>
  </section>
</div>

{{!-- ── Large file ─────────────────────────────────────────────────
     A whole-library .ipq is around two gigabytes, and a form POST holds
     the whole body in memory before a byte can be parsed. So this path
     slices the file in the browser and sends it a chunk at a time; the
     server assembles the chunks on disk and streams the result into the
     table when the last one lands.

     The progress line is the point of this card. An operator watching a
     two-gigabyte transfer needs to see that it is moving. --}}
<section class="range-card" id="range-upload">
  <h3>{{req.t 'admin.ranges.upload.title'}}</h3>
  <p class="admin-section-help">{{req.t 'admin.ranges.upload.help'}}</p>
  <form id="range-upload-form" data-csrf="{{csrfToken}}">
    <div class="form-field">
      <label class="form-field-label" for="range-upload-file">{{req.t 'admin.ranges.upload.file'}}</label>
      <div class="form-field-input">
        <input id="range-upload-file" type="file" accept=".ipq,application/x-ndjson,text/plain">
        <span class="form-field-hint">{{req.t 'admin.ranges.upload.fileHint' ceiling=ceilingLabel}}</span>
      </div>
    </div>
    <div class="form-field">
      <label class="form-field-label" for="range-upload-mode">{{req.t 'admin.ranges.upload.mode'}}</label>
      <div class="form-field-input">
        <select id="range-upload-mode">
          <option value="merge">{{req.t 'admin.ranges.upload.modeMerge'}}</option>
          <option value="replace">{{req.t 'admin.ranges.upload.modeReplace'}}</option>
        </select>
        <span class="form-field-hint">{{req.t 'admin.ranges.upload.modeHint'}}</span>
      </div>
    </div>
    {{!-- The replacement guard, in the large-file path too. The operator
         types the number of ranges currently in the table; a number that
         does not match runs nothing. --}}
    <div class="form-field" id="range-upload-confirm-field" hidden>
      <label class="form-field-label" for="range-upload-confirm">{{req.t 'admin.ranges.replace.confirmLabel'}}</label>
      <div class="form-field-input">
        <input id="range-upload-confirm" type="number" min="0" inputmode="numeric" placeholder="{{currentRows}}">
        <span class="form-field-hint">{{req.t 'admin.ranges.replace.confirmHint'}}</span>
      </div>
    </div>
    <div class="range-upload-progress">
      <progress id="range-upload-progress" max="100" value="0"></progress>
      <span id="range-upload-status" class="form-field-hint"></span>
    </div>
    <button type="button" id="range-upload-start" class="btn-primary">{{req.t 'admin.ranges.upload.action'}}</button>
  </form>
</section>

{{!-- ── Recent imports ───────────────────────────────────────────────
     A whole-library import runs for hours and outlives the tab that
     started it. This list is the record of what happened: how far it got,
     when it finished, and why it failed if it did. --}}
{{#if imports.length}}
<section class="range-card range-imports">
  <h3>{{req.t 'admin.ranges.jobs.title'}}</h3>
  <p class="admin-section-help">{{req.t 'admin.ranges.jobs.help'}}</p>
  <table class="range-export-table">
    <thead>
      <tr>
        <th>{{req.t 'admin.ranges.jobs.started'}}</th>
        <th>{{req.t 'admin.ranges.jobs.mode'}}</th>
        <th>{{req.t 'admin.ranges.jobs.progress'}}</th>
        <th>{{req.t 'admin.ranges.jobs.outcome'}}</th>
      </tr>
    </thead>
    <tbody>
      {{#each imports}}
      <tr class="range-import-row{{#if this.isRunning}} is-running{{/if}}"
          data-import-id="{{this.id}}"
          {{#unless this.isRunning}}data-poll="off"{{/unless}}>
        <td><time datetime="{{this.startedAtLabel}}">{{this.startedAtLabel}}</time></td>
        <td>{{this.mode}}</td>
        <td>
          {{#if this.pct}}
          <span class="range-import-bar"><span class="range-import-bar-fill" style="width: {{this.pct}}%"></span></span>
          <span class="form-field-hint range-import-progress-text">{{this.rowsDone}} / {{this.declaredRows}} ({{this.pct}}%)</span>
          {{else}}
          <span class="form-field-hint range-import-progress-text">{{this.rowsDone}}</span>
          {{/if}}
        </td>
        <td>
          {{#if this.isRunning}}{{@root.req.t 'admin.ranges.jobs.running'}}{{/if}}
          {{#if this.errorMessage}}
          <span class="range-import-error">{{this.errorMessage}}</span>
          {{/if}}
          {{#unless this.errorMessage}}{{#unless this.isRunning}}
          {{@root.req.t 'admin.ranges.jobs.wrote'}} {{this.rowsWritten}} · {{@root.req.t 'admin.ranges.jobs.kept'}} {{this.preserved}}
          {{/unless}}{{/unless}}
        </td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</section>
{{/if}}

{{!-- The bar moves while the page is open: the script polls the job's
     progress endpoint and stops on its own when the job is over. --}}
<script src="/assets/range-progress.js" defer></script>

{{!-- ── Format ───────────────────────────────────────────────────────
     The file is line-delimited JSON and is meant to be readable, so the
     page shows what a row looks like instead of describing it. --}}
<section class="range-card range-format">
  <h3>{{req.t 'admin.ranges.format.title'}}</h3>
  <p class="admin-section-help">{{req.t 'admin.ranges.format.help'}}</p>
  <pre class="range-format-sample"><code>{{req.t 'admin.ranges.format.sample'}}</code></pre>
  <ul class="range-format-notes">
    <li>{{req.t 'admin.ranges.format.note1'}}</li>
    <li>{{req.t 'admin.ranges.format.note2'}}</li>
    <li>{{req.t 'admin.ranges.format.note3'}}</li>
  </ul>
</section>

<script src="/assets/range-upload.js" defer></script>
