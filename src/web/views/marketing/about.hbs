<section class="m-section m-section--first">
  <div class="m-section-inner">
    <div class="m-section-head">
      <span class="m-eyebrow">{{req.t 'about.eyebrow'}}</span>
      <h1 class="m-section-title">{{req.t 'about.heading'}}</h1>
      <p class="m-section-sub">{{req.t 'about.intro'}}</p>
    </div>

    <div class="m-card m-card--soft">
      <h3 class="m-card-title">{{req.t 'about.storyTitle'}}</h3>
      <p>{{req.t 'about.storyP1'}}</p>
      <p>{{req.t 'about.storyP2'}}</p>
    </div>

    <div class="m-features m-features--two">
      <div class="m-feature">
        <h3 class="m-feature-title">{{req.t 'about.principles.sources.title'}}</h3>
        <p class="m-feature-sub">{{req.t 'about.principles.sources.sub'}}</p>
      </div>
      <div class="m-feature">
        <h3 class="m-feature-title">{{req.t 'about.principles.speed.title'}}</h3>
        <p class="m-feature-sub">{{req.t 'about.principles.speed.sub'}}</p>
      </div>
      <div class="m-feature">
        <h3 class="m-feature-title">{{req.t 'about.principles.opensource.title'}}</h3>
        <p class="m-feature-sub">{{req.t 'about.principles.opensource.sub'}}</p>
      </div>
      <div class="m-feature">
        <h3 class="m-feature-title">{{req.t 'about.principles.selfhosted.title'}}</h3>
        <p class="m-feature-sub">{{req.t 'about.principles.selfhosted.sub'}}</p>
      </div>
    </div>

    <div class="m-card m-card--soft">
      <h3 class="m-card-title">{{req.t 'about.stackTitle'}}</h3>
      <ul class="m-list">
        <li>{{req.t 'about.stack.node'}}</li>
        <li>{{req.t 'about.stack.fastify'}}</li>
        <li>{{req.t 'about.stack.mysql'}}</li>
        <li>{{req.t 'about.stack.handlebars'}}</li>
      </ul>
    </div>

    <div class="m-card m-card--soft">
      <h3 class="m-card-title">{{req.t 'about.licenseTitle'}}</h3>
      <p>{{req.t 'about.licenseBody'}}</p>
    </div>
  </div>
</section>