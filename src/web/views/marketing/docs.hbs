<section class="m-section m-section--first">
  <div class="m-section-inner m-docs-page">
    <div class="m-section-head">
      <span class="m-eyebrow">{{req.t "docs.eyebrow"}}</span>
      <h1 class="m-section-title">{{req.t "docs.heading"}}</h1>
      <p class="m-section-sub">{{req.t "docs.subtitle"}}</p>
    </div>

    <div class="m-docs-layout">
      <aside class="m-docs-toc" aria-label="Documentation sections">
        <h4>{{req.t "docs.tocHeading"}}</h4>
        <ul>
          <li><a href="#endpoints">{{req.t "docs.tocEndpoints"}}</a></li>
          <li><a href="#examples">{{req.t "docs.tocExamples"}}</a></li>
          <li><a href="#auth">{{req.t "docs.tocAuth"}}</a></li>
          <li><a href="#response">{{req.t "docs.tocResponse"}}</a></li>
          <li><a href="#ratelimits">{{req.t "docs.tocRateLimits"}}</a></li>
          <li><a href="#errors">{{req.t "docs.tocErrors"}}</a></li>
        </ul>
      </aside>

      <div>
        <h2 id="endpoints" class="m-section-h">{{req.t "docs.endpointsTitle"}}</h2>
        <div class="m-endpoint">
          <div class="m-endpoint-head">
            <span class="m-endpoint-method">GET</span>
            <code class="m-endpoint-path">/lookup?ip=&lt;ip&gt;</code>
          </div>
          <p class="m-endpoint-desc">{{req.t "docs.endpoints.lookup"}}</p>
        </div>
        <div class="m-endpoint">
          <div class="m-endpoint-head">
            <span class="m-endpoint-method">GET</span>
            <code class="m-endpoint-path">/lookup/&lt;ip&gt;</code>
          </div>
          <p class="m-endpoint-desc">{{req.t "docs.endpoints.lookupPath"}}</p>
        </div>
        <div class="m-endpoint">
          <div class="m-endpoint-head">
            <span class="m-endpoint-method">GET</span>
            <code class="m-endpoint-path">/stats</code>
          </div>
          <p class="m-endpoint-desc">{{req.t "docs.endpoints.stats"}}</p>
        </div>
        <div class="m-endpoint">
          <div class="m-endpoint-head">
            <span class="m-endpoint-method">GET</span>
            <code class="m-endpoint-path">/healthz</code>
          </div>
          <p class="m-endpoint-desc">{{req.t "docs.endpoints.healthz"}}</p>
        </div>

        <h2 id="examples" class="m-section-h">{{req.t "docs.examplesTitle"}}</h2>
        <div class="m-codeblock">
          <div class="m-codeblock-tabs">
            <button type="button" class="m-codeblock-tab active" data-tab="curl">curl</button>
            <button type="button" class="m-codeblock-tab" data-tab="js">JavaScript</button>
            <button type="button" class="m-codeblock-tab" data-tab="py">Python</button>
            <button type="button" class="m-codeblock-tab" data-tab="node">Node</button>
          </div>
          <pre data-pane="curl"><code><span class="tok-com"># GET request, no auth needed for basic lookups</span>
              <span class="tok-key">curl</span>
              <span class="tok-str">"{{viewBaseUrl}}/lookup?ip=8.8.8.8"</span>

              <span class="tok-com"># Stats endpoint</span>
              <span class="tok-key">curl</span>
              <span class="tok-str">"{{viewBaseUrl}}/stats"</span></code></pre>
          <pre data-pane="js" style="display:none"><code><span class="tok-key">const</span>
              res =
              <span class="tok-key">await</span>
              <span class="tok-key">fetch</span>(<span class="tok-str">"{{viewBaseUrl}}/lookup?ip=8.8.8.8"</span>);
              <span class="tok-key">const</span>
              data =
              <span class="tok-key">await</span>
              res.<span class="tok-key">json</span>();
              <span class="tok-key">console</span>.log(data.country.code, data.asn.org);</code></pre>
          <pre data-pane="py" style="display:none"><code><span class="tok-key">import</span>
              requests r = requests.<span class="tok-key">get</span>(<span class="tok-str">"{{viewBaseUrl}}/lookup"</span>, params={<span class="tok-str">"ip"</span>:
              <span class="tok-str">"8.8.8.8"</span>})
              <span class="tok-key">print</span>(r.<span class="tok-key">json</span>()[<span class="tok-str">"country"</span>][<span class="tok-str">"code"</span>])</code></pre>
          <pre data-pane="node" style="display:none"><code><span class="tok-key">const</span>
              res =
              <span class="tok-key">await</span>
              <span class="tok-key">fetch</span>(<span class="tok-str">`{{viewBaseUrl}}/lookup?ip=${ip}`</span>);
              <span class="tok-key">const</span>
              data =
              <span class="tok-key">await</span>
              res.<span class="tok-key">json</span>();
              <span class="tok-com">// data.country.code, data.asn.number, data.city?.name</span></code></pre>
        </div>

        <h2 id="auth" class="m-section-h">{{req.t "docs.authTitle"}}</h2>
        <p style="color: var(--m-ink-2); line-height: 1.6;">{{req.t "docs.authBody"}}</p>
        <pre class="m-pre"><code><span class="tok-key">curl</span> -H <span class="tok-str">"Authorization: Bearer ipq_xxxxxxxxxxxx"</span> <span class="tok-str">"{{viewBaseUrl}}/lookup?ip=8.8.8.8"</span></code></pre>
        <p style="color: var(--m-ink-2); line-height: 1.6;">
          {{req.t "docs.authQueryNote"}}
        </p>
        <pre class="m-pre"><code><span class="tok-key">curl</span> <span class="tok-str">"{{viewBaseUrl}}/lookup?ip=8.8.8.8&amp;key=ipq_xxxxxxxxxxxx"</span></code></pre>

        <h2 id="response" class="m-section-h">{{req.t "docs.responseTitle"}}</h2>
        <p style="color: var(--m-ink-2); line-height: 1.6;">{{req.t "docs.responseBody"}}</p>
        <pre class="m-pre"><code><span class="tok-brace">{</span>
            <span class="tok-key">"ip"</span>:
            <span class="tok-str">"8.8.8.8"</span>,
            <span class="tok-key">"country"</span>:
            <span class="tok-brace">{</span>
            <span class="tok-key">"code"</span>:
            <span class="tok-str">"US"</span>,
            <span class="tok-key">"name"</span>:
            <span class="tok-str">"United States"</span>,
            <span class="tok-key">"source"</span>:
            <span class="tok-str">"maxmind"</span>
            <span class="tok-brace">}</span>,
            <span class="tok-key">"region"</span>:
            <span class="tok-str">"California"</span>,
            <span class="tok-key">"city"</span>:
            <span class="tok-brace">{</span>
            <span class="tok-key">"name"</span>:
            <span class="tok-str">"Mountain View"</span>,
            <span class="tok-key">"source"</span>:
            <span class="tok-str">"maxmind"</span>
            <span class="tok-brace">}</span>,
            <span class="tok-key">"isp"</span>:
            <span class="tok-brace">{</span>
            <span class="tok-key">"name"</span>:
            <span class="tok-str">"Google LLC"</span>,
            <span class="tok-key">"source"</span>:
            <span class="tok-str">"maxmind"</span>
            <span class="tok-brace">}</span>,
            <span class="tok-key">"asn"</span>:
            <span class="tok-brace">{</span>
            <span class="tok-key">"number"</span>:
            <span class="tok-num">15169</span>,
            <span class="tok-key">"org"</span>:
            <span class="tok-str">"Google LLC"</span>,
            <span class="tok-key">"source"</span>:
            <span class="tok-str">"maxmind"</span>
            <span class="tok-brace">}</span>
            <span class="tok-brace">}</span></code></pre>

        <h2 id="ratelimits" class="m-section-h">{{req.t "docs.rateLimitsTitle"}}</h2>
        <p style="color: var(--m-ink-2); line-height: 1.6;">{{req.t "docs.rateLimitsBody"}}</p>
        <table class="m-docs-table">
          <thead>
            <tr><th>{{req.t "docs.colScope"}}</th><th>{{req.t "docs.colLimit"}}</th><th>{{req.t "docs.colDescription"}}</th></tr>
          </thead>
          <tbody>
            <tr><td><code>{{req.t "docs.rateLimits.publicScope"}}</code></td><td><code>{{publicRateLimit}}/min</code></td><td>{{req.t "docs.rateLimits.publicDesc"}}</td></tr>
            <tr><td><code>{{req.t "docs.rateLimits.keyedScope"}}</code></td><td><code>{{req.t "docs.rateLimits.notLimited"}}</code></td><td>{{req.t "docs.rateLimits.keyedDesc"}}</td></tr>
            <tr><td><code>{{req.t "docs.rateLimits.adminScope"}}</code></td><td><code>120/min</code></td><td>{{req.t "docs.rateLimits.adminDesc"}}</td></tr>
          </tbody>
        </table>
        <p style="color: var(--m-ink-2); line-height: 1.6; margin-top: 16px;">
          {{req.t "docs.rateLimitsScopeNote"}}
        </p>

        <h2 id="errors" class="m-section-h">{{req.t "docs.errorsTitle"}}</h2>
        <table class="m-docs-table">
          <thead>
            <tr><th>{{req.t "docs.colStatus"}}</th><th>{{req.t "docs.colCode"}}</th><th>{{req.t "docs.colDescription"}}</th></tr>
          </thead>
          <tbody>
            <tr><td><code>200</code></td><td>—</td><td>{{req.t "docs.errors.200"}}</td></tr>
            <tr><td><code>400</code></td><td><code>invalid_ip</code></td><td>{{req.t "docs.errors.400"}}</td></tr>
            <tr><td><code>404</code></td><td><code>not_found</code></td><td>{{req.t "docs.errors.404"}}</td></tr>
            <tr><td><code>429</code></td><td><code>rate_limited</code></td><td>{{req.t "docs.errors.429"}}</td></tr>
          </tbody>
        </table>

        <div style="margin-top: 32px;">
          {{#if req.user}}
            <a href="/dashboard" class="button">{{req.t "home.cta.primaryAuthed"}}</a>
          {{else}}
            <a href="/signup" class="button">{{req.t "home.cta.primary"}}</a>
            <a href="/try" class="button-ghost" style="margin-left: 8px;">{{req.t "docs.cta.try"}}</a>
          {{/if}}
        </div>
      </div>
    </div>
  </div>
</section>