{
  "name": "ipquery",
  "version": "0.1.0",
  "description": "IP geolocation aggregator over MaxMind, ip2region, DB-IP",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-schema.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "serve:4001": "node -e \"require('child_process').spawnSync(process.execPath,['dist/cli.js','serve'],{env:{...process.env,PORT:'4001'},stdio:'inherit'})\""
  },
  "dependencies": {
    "@fastify/compress": "^7.0.3",
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/formbody": "^7.4.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/static": "^7.0.4",
    "@fastify/view": "^9.1.0",
    "argon2": "^0.45.1",
    "commander": "^12.1.0",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "fastify": "^4.28.0",
    "handlebars": "^4.7.9",
    "maxmind": "^4.3.10",
    "mysql2": "^3.11.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^9.0.5"
  },
  "devDependencies": {
    "@types/handlebars": "^4.0.40",
    "@types/node": "^20.14.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^2.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
