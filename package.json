{
  "name": "ipquery",
  "version": "0.1.0",
  "description": "IP geolocation aggregator over MaxMind, ip2region, DB-IP",
  "license": "MIT",
  "type": "commonjs",
  "engines": { "node": ">=20.0.0" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "fastify": "^4.28.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/compress": "^7.0.3",
    "mysql2": "^3.11.0",
    "maxmind": "^4.3.10",
    "node-cron": "^3.0.3",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "tsx": "^4.19.0",
    "vitest": "^2.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "supertest": "^7.0.0",
    "@types/node": "^20.14.0",
    "@types/supertest": "^6.0.2"
  }
}